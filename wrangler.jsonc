{
  "name": "bibibox",
  "compatibility_date": "2026-09-01",
  // Only /api/* runs the Worker (RoGuessr). Everything else is static assets: free and unlimited.
  "main": "worker/index.js",
  // Served on bibibox.xyz (Cloudflare creates the DNS record and the HTTPS certificate). www.bibibox.xyz
  // redirects to it with a zone Redirect Rule, so search engines only see one site.
  "routes": [{ "pattern": "bibibox.xyz", "custom_domain": true }],
  "workers_dev": false, // one public address only (bibibox.xyz), so zone security rules always apply
  "preview_urls": false,
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "404-page", "run_worker_first": ["/api/*"] },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "MATCH", "class_name": "Matchmaker" },
      { "name": "LB", "class_name": "Leaderboard" },
      { "name": "RACE", "class_name": "Race" },
      { "name": "NIGHT", "class_name": "Night" }
    ]
  },
  // SQLite-backed Durable Objects are available on the Workers Free plan.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room", "Matchmaker", "Leaderboard"] },
    { "tag": "v2", "new_sqlite_classes": ["Race"] },
    { "tag": "v3", "new_sqlite_classes": ["Night"] }
  ]
}
