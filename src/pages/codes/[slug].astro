---
import Base from '../../layouts/Base.astro';
import GameHeader from '../../components/GameHeader.astro';
import Side from '../../components/Side.astro';
import { games, monthYear, date, isNew, updatedAt, ratingLD, SITE_NAME } from '../../lib/data.js';

export const getStaticPaths = () => games.map((g) => ({ params: { slug: g.slug }, props: { g } }));
const { g } = Astro.props;
const { active, expired } = g.codes;
const n = active.length;
const faq = [
  { q: `What are the newest ${g.title} giftcodes?`, a: n ? `The newest giftcodes are ${active.slice(0, 3).map((c) => `${c.code} (${c.reward})`).join(', ')}.` : `There are no working ${g.title} giftcodes right now. We check for new ones every 2 hours, so bookmark this page.` },
  { q: `How many ${g.title} redeem codes are active?`, a: `As of ${date(updatedAt)} there ${n === 1 ? 'is 1 active redeem code' : `are ${n} active redeem codes`} and ${expired.length} expired giftcodes.` },
  { q: `Best way to redeem ${g.title} giftcodes?`, a: 'Giftcodes are usually case-sensitive, so copy them exactly (use our copy button). Some codes need a minimum level, only work once per account, or have expired - check the expired list below.' },
  { q: `When do new ${g.title} giftcodes come out?`, a: `New giftcodes usually drop with updates, events and milestones. The last ${g.title} update was on ${date(g.updated)}.` },
];
const howToSteps = [
  `Open ${g.title} on Roblox and join a server.`,
  'Look for a Codes, Shop, Gift or Settings button on the side of the screen or in the menu.',
  'Paste a code from the list above into the text box.',
  'Press Redeem / Enter and enjoy your free rewards!',
];
// Honest per-page freshness: when this game's codes last changed (latest code
// added), falling back to the game's own last Roblox update.
const lastChanged = active.map((c) => c.added).filter(Boolean).sort().pop() ?? g.updated;
const pageUrl = new URL(`/codes/${g.slug}/`, Astro.site).href;
const schema = [
  { '@context': 'https://schema.org', '@type': 'WebPage', '@id': `${pageUrl}#webpage`, url: pageUrl, name: `${g.title} Giftcodes & Redeem Codes`, isPartOf: { '@id': `${Astro.site}#website` }, dateModified: new Date(lastChanged).toISOString(), author: { '@type': 'Organization', name: SITE_NAME, url: Astro.site.href }, publisher: { '@id': `${Astro.site}#org` } },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [['Home', '/'], ['Codes', '/codes/'], [`${g.title} Giftcodes`, `/codes/${g.slug}/`]].map(([name, p], i) => ({ '@type': 'ListItem', position: i + 1, name, item: new URL(p, Astro.site).href })) },
  { '@context': 'https://schema.org', '@type': 'HowTo', name: `How to Redeem ${g.title} Giftcodes`, step: howToSteps.map((t, i) => ({ '@type': 'HowToStep', position: i + 1, text: t })), totalTime: 'PT1M' },
  ratingLD(g) && { '@context': 'https://schema.org', '@type': 'VideoGame', name: g.title, url: pageUrl, image: g.icon, applicationCategory: 'Game', sameAs: `https://www.roblox.com/games/${g.placeId}`, aggregateRating: ratingLD(g) },
];
---
<Base
  title={`${g.title} Giftcodes & Redeem Codes - ${n ? `${n} FREE [Working]` : `New Codes [${new Date().getFullYear()}]`}`}
  description={n ? `${n} working ${g.title} giftcodes + redeem codes for ${monthYear}. Free ${active[0].reward.toLowerCase()}: ${active.slice(0, 3).map((c) => c.code).join(', ')} + more. Copy-paste in-game. 💰 Updated every 2 hours.` : `${g.title} giftcodes & redeem codes 2026 - new free codes checked every 2 hours. How to redeem + full expired list.`}
  image={g.thumbs[0] ?? g.icon}
  schema={schema}
  noindex={n === 0}
>
  <GameHeader g={g} page="codes" h1={`${g.title} Giftcodes & Redeem Codes [${monthYear}]`} sub={`✅ ${n} active · ⏰ Updated ${date(updatedAt)} · ❌ ${expired.length} expired`} />

  <div class="layout" style="margin-top:28px">
    <div style="display:grid;gap:24px;min-width:0">
      <div class="neu box" id="active">
        <h2>✅ Working {g.title} Giftcodes & Redeem Codes</h2>
        {n > 0 && <div style="margin:-4px 0 16px"><span class="small">🏆 Code Hunter: you copied <b data-got>0</b> of {n} free giftcodes</span><div class="progress"><i data-bar></i></div></div>}
        {n ? (
          <div class="rows">
            {active.map((c) => (
              <div class="code inset" data-code={c.code}>
                <div class="grow">
                  <kbd>{c.code}</kbd> {isNew(c) && <span class="tag green">NEW</span>}
                  <div class="reward">{c.reward}</div>
                </div>
                <button class="btn copy" type="button">Copy</button>
              </div>
            ))}
          </div>
        ) : (
          <p class="muted">There are no active {g.title} codes right now. New codes usually arrive with the next update - we check every 2 hours, so come back soon!</p>
        )}
        <p class="small muted" style="margin:14px 0 0">Tap a code to copy it. We mark codes you already copied so you can keep track.</p>
      </div>

      <div class="neu box prose">
        <h2>How to redeem {g.title} codes</h2>
        <ol>
          <li>Open <a href={`https://www.roblox.com/games/${g.placeId}`} target="_blank" rel="noopener nofollow">{g.title} on Roblox</a> and join a server.</li>
          <li>Look for a <b>Codes</b>, <b>Shop</b>, <b>Gift</b> or <b>Settings</b> button - usually on the side of the screen or in the menu.</li>
          <li>Paste a code from the list above into the text box.</li>
          <li>Press <b>Redeem</b> / <b>Enter</b> and enjoy your free rewards!</li>
        </ol>
      </div>

      {expired.length > 0 && (
        <details class="neu box">
          <summary>❌ Expired codes ({expired.length})</summary>
          <p class="small muted">These codes no longer work.</p>
          <div class="expired">{expired.map((c) => <s>{c}</s>)}</div>
        </details>
      )}

      <a class="neu box" href={`/games/${g.slug}/`} style="display:flex;gap:16px;align-items:center">
        <span style="font-size:2rem">📘</span>
        <span><b style="color:var(--head)">{g.title} guide: tips, tricks & badges</b><br /><span class="small muted">Beginner guide, all {g.badges.length} badges, game passes and update history →</span></span>
      </a>

      <div class="faq" style="display:grid;gap:10px">
        <h2>{g.title} codes FAQ</h2>
        {faq.map((f, i) => <details class="neu" open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </div>
    </div>
    <Side g={g} />
  </div>

  <script>
    const KEY = 'copied-codes';
    const read = (): string[] => { try { return JSON.parse(localStorage.getItem(KEY) || '[]'); } catch { return []; } };
    const copied = new Set(read());
    const all = [...document.querySelectorAll<HTMLElement>('[data-code]')];
    const progress = () => {
      const got = all.filter((el) => copied.has(el.dataset.code!)).length;
      const n = document.querySelector('[data-got]'); if (n) n.textContent = String(got);
      const bar = document.querySelector<HTMLElement>('[data-bar]'); if (bar) bar.style.width = (got / all.length) * 100 + '%';
      if (got === all.length && all.length && !document.querySelector('[data-done]')) document.querySelector('[data-got]')?.parentElement?.insertAdjacentHTML('beforeend', '<b data-done> 🎉 All collected!</b>');
    };
    progress();
    for (const el of all) {
      const code = el.dataset.code!;
      if (copied.has(code)) el.classList.add('tried');
      el.addEventListener('click', async () => {
        const btn = el.querySelector('button')!;
        try { await navigator.clipboard.writeText(code); } catch {}
        btn.textContent = 'Copied!';
        btn.classList.add('done');
        el.classList.add('tried');
        copied.add(code);
        try { localStorage.setItem(KEY, JSON.stringify([...copied].slice(-500))); } catch {}
        progress();
        setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('done'); }, 1500);
      });
    }
  </script>
</Base>
