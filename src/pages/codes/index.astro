---
import Base from '../../layouts/Base.astro';
import { games, monthYear, fmt, newCodes, hasCodes } from '../../lib/data.js';
const list = games.filter(hasCodes).sort((a, b) => newCodes(b) - newCodes(a) || b.codes.active.length - a.codes.active.length || b.playing - a.playing);
const total = games.reduce((s, g) => s + g.codes.active.length, 0);
const schema = [{ '@context': 'https://schema.org', '@type': 'ItemList', name: `All Roblox Codes (${monthYear})`, numberOfItems: list.length, itemListElement: list.slice(0, 30).map((g, i) => ({ '@type': 'ListItem', position: i + 1, url: `https://bibibox.xyz/codes/${g.slug}/`, name: `${g.title} Codes` })) }];
---
<Base title={`ALL Roblox Codes (${monthYear}) - ${total} FREE Redeem Codes`} description={`Every working Roblox redeem code & gift code for ${monthYear}: ${total} codes across ${list.length} top games! Copy-paste them before they expire. Updated every 2 hours.`} image={list[0]?.thumbs?.[0] ?? list[0]?.icon} schema={schema}>
  <section class="hero">
    <span class="pill">Updated every 2 hours</span>
    <h1>All Roblox codes ({monthYear})</h1>
    <p>{total} working codes for {list.length} games. Games with brand-new codes are listed first. <a href="/codes/new/">See only the newest codes →</a></p>
  </section>
  <div class="rows">
    {list.map((g) => (
      <a class="row neu" href={`/codes/${g.slug}/`}>
        <img src={g.icon} alt="" width="48" height="48" loading="lazy" />
        <div class="grow"><b>{g.title} codes</b><span class="small muted">{g.genre} · {fmt(g.playing)} playing</span></div>
        {newCodes(g) > 0 && <span class="tag green">{newCodes(g)} NEW</span>}
        <span class="tag accent">{g.codes.active.length} codes</span>
      </a>
    ))}
  </div>
</Base>
