---
import Base from '../layouts/Base.astro';
import { ZONES } from '../lib/world.js';
---
<Base title="Blox World: Explore a Roblox-Style Island and Guess Where You Are" description="GeoGuessr in a blocky Roblox-style world! Walk around a new island every game with your own avatar, spot the landmarks and pin your location on the map. Free, unlimited, daily world.">
  <section class="hero" style="padding-bottom:10px">
    <span class="pill">🧱 New · Walk around in 3D</span>
    <h1><span class="grad">Blox World</span>: where on the island are you?</h1>
    <p>You drop into a blocky island with your own avatar. Explore, spot the landmarks, then pin where you think you are!</p>
  </section>

  <div class="bw">
    <canvas id="bw-canvas" aria-label="Blox World 3D view"></canvas>

    <div id="bw-menu" class="bw-panel bw-center" hidden>
      <div class="bw-card">
        <span class="bw-logo">🧱</span>
        <h2>Blox World</h2>
        <p class="muted">A new Roblox-style island every game. 5 rounds, 75 seconds each.</p>
        <div id="bw-challenge" class="rg-banner" hidden style="margin:10px 0">
          <span>⚔️ A friend sent you this world. Can you beat them?</span>
          <button class="btn gold" data-bw-start="challenge" type="button">Play their world</button>
        </div>
        <div class="bw-btns">
          <button class="btn play bw-big" data-bw-start="random" type="button">▶ Play</button>
          <button class="btn primary" data-bw-start="daily" type="button">📅 Daily world</button>
        </div>
        <p id="bw-best" class="small" style="color:var(--gold);margin:10px 0 0"></p>
        <div class="bw-how">
          <span><kbd>W A S D</kbd> or 🕹️ move</span><span><kbd>Space</kbd> jump</span><span>Drag to look</span><span><kbd>M</kbd> map</span>
        </div>
      </div>
    </div>

    <div id="bw-hud" hidden>
      <div class="bw-top">
        <div class="bw-chip"><b id="bw-round"></b><span id="bw-seed" class="small muted"></span></div>
        <div class="bw-compass" aria-hidden="true"><span id="bw-needle">▲</span><small>N</small></div>
        <div class="bw-chip bw-right">
          <svg class="bw-timer" viewBox="0 0 36 36" aria-hidden="true"><circle r="15.9" cx="18" cy="18" /><circle id="bw-ring" r="15.9" cx="18" cy="18" /></svg>
          <span id="bw-time" class="bw-time"></span>
          <span>⭐ <b id="bw-score">0</b></span>
        </div>
      </div>
      <div id="bw-banner" class="bw-banner"></div>
      <button id="bw-mapbtn" class="btn gold bw-mapbtn" type="button">🗺️ I know where I am!</button>
      <button id="bw-jump" class="bw-jump" type="button" hidden aria-label="Jump">⤒</button>
      <div id="bw-joy" class="bw-joy" hidden><i id="bw-knob"></i></div>
    </div>

    <div id="bw-map" class="bw-mappanel" hidden>
      <div class="bw-maphead"><b>🗺️ Tap where you think you are</b><button id="bw-mapclose" class="btn" type="button">← Keep exploring</button></div>
      <div id="bw-mapwrap" class="bw-mapwrap"><canvas id="bw-mapcanvas"></canvas><div id="bw-result" class="bw-result" hidden></div></div>
      <button id="bw-confirm" class="btn play" type="button" disabled>📍 Confirm guess</button>
    </div>

    <div id="bw-summary" class="bw-panel bw-center" hidden>
      <div class="bw-card">
        <div id="bw-sum"></div>
        <div class="bw-btns">
          <button id="bw-again" class="btn play" type="button">🔄 New world</button>
          <button id="bw-daily" class="btn primary" type="button">📅 Daily world</button>
          <button id="bw-share" class="btn" type="button">📤 Challenge a friend</button>
        </div>
      </div>
    </div>
  </div>
  <canvas id="bw-confetti" aria-hidden="true"></canvas>

  <section class="neu box prose" style="margin-top:28px">
    <h2>How to play Blox World</h2>
    <ol>
      <li>You drop somewhere on a Roblox-style island with 9 themed zones.</li>
      <li>Walk around (WASD or the joystick), jump and look for landmarks: a lighthouse, a windmill, a haunted house...</li>
      <li>Open the map and drop your pin where you think you are. The closer, the more points (up to 5,000 per round).</li>
      <li>Every game makes a brand-new island. Play the <b>Daily world</b> to compare with friends!</li>
    </ol>
    <h3>Zones you can find</h3>
    <div class="chips">{Object.values(ZONES).map((z) => <span class="rg-chip on">{z.emoji} {z.name}</span>)}</div>
  </section>

  <style is:global>
    .bw { position: relative; height: min(78vh, 720px); min-height: 460px; border-radius: 20px; overflow: hidden; background: #9fdcff; box-shadow: var(--neu-lg); touch-action: none; user-select: none; }
    #bw-canvas { width: 100%; height: 100%; display: block; outline: none; }
    .bw-panel { position: absolute; inset: 0; }
    .bw-center { display: grid; place-items: center; background: linear-gradient(180deg, rgba(23, 27, 36, 0.15), rgba(23, 27, 36, 0.65)); }
    .bw-card { width: min(440px, calc(100% - 32px)); max-height: calc(100% - 24px); overflow: auto; text-align: center; padding: 22px; border-radius: 22px; background: rgba(23, 27, 36, 0.86); backdrop-filter: blur(10px); box-shadow: 0 20px 60px rgba(0, 0, 0, 0.45); animation: bw-pop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1); }
    .bw-card h2 { font-size: 2rem; margin: 4px 0; }
    .bw-logo { font-size: 3.4rem; display: inline-block; animation: bw-float 2.4s ease-in-out infinite; }
    .bw-btns { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; margin-top: 14px; }
    .bw-big { font-size: 1.2rem; padding: 14px 30px; animation: bw-glow 2s ease-in-out infinite; }
    .bw-how { display: flex; flex-wrap: wrap; gap: 8px 14px; justify-content: center; margin-top: 16px; font-size: 12px; color: var(--muted); }
    .bw-how kbd { font: 700 11px ui-monospace, monospace; padding: 2px 6px; border-radius: 6px; background: var(--bg-2); color: var(--head); }
    @keyframes bw-pop { from { transform: scale(0.8) translateY(20px); opacity: 0; } }
    @keyframes bw-float { 50% { transform: translateY(-8px) rotate(-6deg); } }
    @keyframes bw-glow { 50% { box-shadow: 0 4px 0 #1f8a5a, 0 0 26px rgba(62, 207, 142, 0.6); } }
    .bw-top { position: absolute; top: 10px; left: 10px; right: 10px; display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; pointer-events: none; }
    .bw-chip { display: flex; flex-direction: column; padding: 8px 12px; border-radius: 14px; background: rgba(23, 27, 36, 0.72); backdrop-filter: blur(6px); color: var(--head); font-family: var(--fun); }
    .bw-right { flex-direction: row; align-items: center; gap: 10px; }
    .bw-timer { width: 40px; height: 40px; transform: rotate(-90deg); }
    .bw-timer circle { fill: none; stroke: rgba(255, 255, 255, 0.15); stroke-width: 3.2; }
    .bw-timer #bw-ring { stroke: var(--green); stroke-dasharray: 100; stroke-linecap: round; }
    .bw-time { margin-left: -44px; width: 40px; text-align: center; font: 700 14px var(--fun); }
    .bw-time.hurry { color: var(--red); animation: bw-beat 0.5s infinite; }
    @keyframes bw-beat { 50% { transform: scale(1.25); } }
    .bw-compass { width: 46px; height: 46px; border-radius: 50%; background: rgba(23, 27, 36, 0.72); display: grid; place-items: center; position: relative; color: #ff5fa2; font-size: 18px; }
    .bw-compass small { position: absolute; top: 1px; font: 700 9px var(--fun); color: var(--head); }
    #bw-needle { display: inline-block; transition: transform 0.1s linear; }
    .bw-banner { position: absolute; top: 22%; left: 50%; translate: -50% 0; text-align: center; pointer-events: none; opacity: 0; display: grid; }
    .bw-banner b { font: 700 clamp(2rem, 6vw, 3.4rem) var(--fun); color: #fff; text-shadow: 0 4px 20px rgba(0, 0, 0, 0.45); }
    .bw-banner span { font: 600 1rem var(--fun); color: #fff; text-shadow: 0 2px 10px rgba(0, 0, 0, 0.6); }
    .bw-banner.go { animation: bw-banner 2.4s ease both; }
    @keyframes bw-banner { 0% { opacity: 0; transform: scale(0.6) translateY(20px); } 15% { opacity: 1; transform: scale(1.08); } 25%, 75% { opacity: 1; transform: scale(1); } 100% { opacity: 0; transform: translateY(-20px); } }
    .bw-mapbtn { position: absolute; right: 14px; bottom: 14px; font-size: 1rem; padding: 14px 20px; }
    .bw-jump { position: absolute; right: 18px; bottom: 84px; width: 64px; height: 64px; border-radius: 50%; border: 0; font-size: 26px; color: #fff; background: rgba(109, 127, 240, 0.85); box-shadow: 0 4px 0 #4453b8; }
    .bw-jump:active { transform: translateY(3px); box-shadow: none; }
    .bw-joy { position: absolute; width: 110px; height: 110px; margin: -55px 0 0 -55px; border-radius: 50%; background: rgba(255, 255, 255, 0.16); border: 2px solid rgba(255, 255, 255, 0.35); pointer-events: none; }
    .bw-joy i { position: absolute; left: 50%; top: 50%; width: 46px; height: 46px; margin: -23px 0 0 -23px; border-radius: 50%; background: rgba(255, 255, 255, 0.7); }
    .bw-mappanel { position: absolute; right: 12px; top: 64px; bottom: 12px; width: min(460px, calc(100% - 24px)); display: flex; flex-direction: column; gap: 10px; padding: 12px; border-radius: 18px; background: rgba(23, 27, 36, 0.9); backdrop-filter: blur(8px); animation: bw-slide 0.35s cubic-bezier(0.22, 1, 0.36, 1); }
    @keyframes bw-slide { from { transform: translateX(40px); opacity: 0; } }
    .bw-maphead { display: flex; justify-content: space-between; align-items: center; gap: 8px; color: var(--head); font-family: var(--fun); }
    .bw-maphead .btn { font-size: 12px; padding: 7px 12px; }
    .bw-mapwrap { position: relative; flex: 1; min-height: 0; display: grid; place-items: center; }
    #bw-mapcanvas { border-radius: 14px; cursor: crosshair; background: #2f8fe0; box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35); }
    .bw-result { position: absolute; left: 8px; right: 8px; bottom: 8px; text-align: center; padding: 10px; border-radius: 14px; background: rgba(23, 27, 36, 0.9); backdrop-filter: blur(6px); animation: bw-up 0.45s cubic-bezier(0.34, 1.56, 0.64, 1); }
    @keyframes bw-up { from { transform: translateY(30px); opacity: 0; } }
    .bw-result p { margin: 4px 0; }
    .bw-pts { font: 700 2.2rem var(--fun); background: var(--brand); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .bw-rounds { display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; margin: 14px 0; }
    .bw-rounds div { display: grid; padding: 8px 4px; border-radius: 12px; background: var(--bg-2); animation: bw-pop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) both; animation-delay: calc(var(--i) * 0.12s); }
    .bw-rounds b { color: var(--muted); font-size: 12px; } .bw-rounds span { font: 700 1rem var(--fun); color: var(--head); } .bw-rounds small { font-size: 10px; color: var(--muted); }
    #bw-confetti { position: fixed; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 50; }
    @media (max-width: 640px) {
      .bw { height: 76vh; border-radius: 14px; }
      .bw-mappanel { left: 8px; right: 8px; width: auto; top: auto; height: 72%; }
      .bw-mapbtn { left: 50%; right: auto; translate: -50% 0; bottom: 10px; font-size: 0.9rem; }
      .bw-jump { bottom: 70px; }
    }
  </style>
  <script>
    import '../scripts/bloxworld.ts';
  </script>
</Base>
