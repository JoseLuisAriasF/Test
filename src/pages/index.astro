---
import Base from '../layouts/Base.astro';
import GameCard from '../components/GameCard.astro';
import { top, games, withCodes, genres, trending, rising, full, monthYear, slugOf, date, emoji, isNew, change24, SITE_NAME } from '../lib/data.js';

const totalPlaying = top.reduce((s, g) => s + g.playing, 0);
const totalCodes = games.reduce((s, g) => s + g.codes.active.length, 0);
const newToday = games.flatMap((g) => g.codes.active.filter(isNew).map((c) => ({ ...c, g })));
const latestCodes = games.flatMap((g) => g.codes.active.filter((c) => c.added).map((c) => ({ ...c, g }))).sort((a, b) => b.added.localeCompare(a.added)).slice(0, 8);
const recentlyUpdated = [...top].sort((a, b) => b.updated.localeCompare(a.updated)).slice(0, 6);
const hotNow = [...games].filter((g) => change24(g) !== null).sort((a, b) => change24(b) - change24(a)).slice(0, 6);
const schema = [{
  '@context': 'https://schema.org', '@type': 'ItemList', name: 'Most played Roblox games right now',
  itemListElement: top.map((g, i) => ({ '@type': 'ListItem', position: i + 1, url: new URL(`/games/${g.slug}/`, Astro.site).href, name: g.title })),
}];
---
<Base
  title={`Roblox Codes (${monthYear}) - ${totalCodes} FREE Codes & Top 50 Games Live | ${SITE_NAME}`}
  description={`${totalCodes} working Roblox redeem codes & gift codes for ${monthYear}! ${top.slice(0, 4).map((g) => g.title).join(', ')} and ${top.length - 4} more games. Updated every 2 hours, 100% free. Grab them before they expire!`}
  image={top[0]?.thumbs[0]}
  schema={schema}
>
  <section class="hero" style="position:relative">
    <span class="floaty" style="left:4%;top:30px" aria-hidden="true">🎁</span>
    <span class="floaty" style="right:6%;top:60px;animation-delay:-2s" aria-hidden="true">💎</span>
    <span class="floaty" style="left:12%;bottom:10px;animation-delay:-3.5s" aria-hidden="true">⭐</span>
    <span class="pill"><i class="dot"></i>Live · {full(totalPlaying)} players right now</span>
    <h1>Free rewards for the games <span class="grad">everyone is playing</span></h1>
    <p>Every working code for the top {top.length} Roblox games, checked every 2 hours. Plus tips, tricks, updates and a new game to play every day!</p>
    <div data-search style="position:relative;max-width:520px;margin:0 auto">
      <label class="search"><span aria-hidden="true">🔍</span><input type="search" placeholder="Find your game: Blox Fruits, Adopt Me…" aria-label="Search games" /></label>
      <div class="results neu" hidden></div>
    </div>
    <div class="stats">
      <span>🎁 <b>{totalCodes}</b> working codes</span>
      <span>🎮 <b>{games.length}</b> games</span>
      <span>💯 <b>100%</b> free</span>
    </div>
    {newToday.length > 0 && (
      <div class="banner">✨ <span><b>{newToday.length} new codes</b> in the last 3 days for {[...new Set(newToday.map((c) => c.g.title))].slice(0, 3).join(', ')}</span> <a href="/codes/">See them →</a></div>
    )}
  </section>

  <section class="tiles">
    <a class="tile t2 rg-feature" href="/guessr/"><b>🕵️ RoGuessr: battle live!</b><span>Guess the Roblox game from a screenshot. Beat other players in real time.</span><i>⚔️</i></a>
    <a class="tile t4" href="/golf/"><b>⛳ Golf Climb</b><span>One ball, 10 mountains, one guardian angel. Beat the speedrun ranking!</span><i>⛳</i></a>
    <a class="tile t2" href="/typing/"><b>🔦 Night Shift</b><span>Scary typing game: type fast or the animatronics get you. Up to 4 players!</span><i>🐻</i></a>
    <a class="tile t1" href="/play/"><b>Guess the Game</b><span>A new mystery Roblox game every day. Can you get it in 1 try?</span><i>🎮</i></a>
    <a class="tile t3" href="/blox-world/"><b>🧱 Blox World</b><span>Explore a Roblox-style island in 3D. Where are you?</span><i>🧱</i></a>
    <a class="tile t4" href="/real-world/"><b>🌍 Real World</b><span>Real 360° streets. Guess the place on the map!</span><i>🌍</i></a>
    <a class="tile t1" href="/quiz/"><b>Which game is for you?</b><span>Answer 4 fun questions and find your perfect game.</span><i>✨</i></a>
    <a class="tile t3" href="/trending/"><b>Trending now</b><span>Games blowing up today, before everyone else finds them.</span><i>📈</i></a>
    <a class="tile t4" href="/codes/"><b>Code Hunter</b><span>Copy codes to grow your collection. How many can you get?</span><i>🏆</i></a>
  </section>

  <section>
    <div class="sec-head">
      <div><h2>🔥 Top {top.length} most played right now</h2><p>Ranked by live players. ▲▼ = places moved since last check.</p></div>
      <a class="more" href="/top/">Live ranking →</a>
    </div>
    <div class="grid clip" id="top-grid">
      {top.map((g, i) => <GameCard g={g} eager={i < 6} />)}
    </div>
    <div class="center"><button class="btn primary" id="show-more">Show all {top.length} games ↓</button></div>
  </section>

  <section hidden={!latestCodes.length}>
    <div class="sec-head">
      <div><h2>🎁 Newest codes</h2><p>Freshly found codes. Redeem them before they expire!</p></div>
      <a class="more" href="/codes/">All codes →</a>
    </div>
    <div class="rows">
      {latestCodes.map((c) => (
        <a class="row neu" href={`/codes/${c.g.slug}/`}>
          <img src={c.g.icon} alt="" width="48" height="48" loading="lazy" />
          <div class="grow"><b>{c.code}</b><span class="small muted">{c.g.title} · {c.reward}</span></div>
          <span class="tag green">{date(c.added)}</span>
        </a>
      ))}
    </div>
  </section>

  {hotNow.length > 0 && (
    <section>
      <div class="sec-head"><div><h2>🚀 Blowing up today</h2><p>Biggest jump in players over the last 24 hours.</p></div><a class="more" href="/trending/">Trending →</a></div>
      <div class="grid">{hotNow.map((g) => <GameCard g={g} />)}</div>
    </section>
  )}

  {rising.length > 0 && (
    <section>
      <div class="sec-head"><div><h2>🌟 Rising stars</h2><p>New games Roblox is pushing. Be the first of your friends to play!</p></div><a class="more" href="/trending/">See all →</a></div>
      <div class="grid">{rising.slice(0, 6).map((g) => <GameCard g={g} href={`/games/${g.slug}/`} />)}</div>
    </section>
  )}

  <section>
    <div class="sec-head"><div><h2>🛠️ Just updated</h2><p>Games that shipped an update most recently.</p></div></div>
    <div class="grid">
      {recentlyUpdated.map((g) => <GameCard g={g} href={`/games/${g.slug}/`} />)}
    </div>
  </section>

  <section>
    <div class="sec-head"><div><h2>Pick your favorite type</h2></div></div>
    <div class="chips">
      {genres.map(([name, list]) => <a href={`/genre/${slugOf(name)}/`}>{emoji(name)} {name}<small>{list.length}</small></a>)}
    </div>
  </section>

  <section>
    <div class="sec-head"><div><h2>💰 Games with the most codes</h2><p>Stack up free rewards.</p></div></div>
    <div class="grid">
      {[...withCodes].sort((a, b) => b.codes.active.length - a.codes.active.length).slice(0, 6).map((g) => <GameCard g={g} />)}
    </div>
  </section>

  {trending.length > 0 && (
    <section>
      <div class="sec-head"><div><h2>📈 Top trending</h2><p>What Roblox players are clicking on right now.</p></div></div>
      <div class="grid">{trending.slice(0, 6).map((g) => <GameCard g={g} />)}</div>
    </section>
  )}

  <script>
    document.getElementById('show-more')?.addEventListener('click', (e) => {
      document.getElementById('top-grid')!.classList.remove('clip');
      (e.currentTarget as HTMLElement).remove();
    });
  </script>
</Base>
