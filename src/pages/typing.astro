---
import Base from '../layouts/Base.astro';
import { MAX_PLAYERS, HOUR } from '../lib/typer.js';
const rows = ['qwertyuiop', "asdfghjkl'", 'zxcvbnm,.?!'];
---
<Base title="Night Shift: Scary Typing Game (FNAF-Style, Roblox Theme) Online" description="A spooky FNAF-style typing game in a Roblox-style pizzeria. Type the words before the animatronics reach your desk! Play solo, against bots or with up to 4 friends. Free, full screen, no download.">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Creepster&family=VT323&display=swap" />
  <section class="hero" style="padding-bottom:10px">
    <span class="pill">🔦 New · Horror typing</span>
    <h1><span class="grad">Night Shift</span>: type or get caught</h1>
    <p>Your first night as the security guard at Bibi's Pizza. Type every word on your monitor. Every mistake wakes the animatronics up… and they walk to your desk.</p>
  </section>

  <div class="ns game" id="ns">
    <canvas id="ns-canvas" aria-label="Night Shift game"></canvas>
    <div class="ns-fx" aria-hidden="true"><i class="ns-grain"></i><i class="ns-lines"></i><i class="ns-danger"></i><i class="ns-static" id="ns-static"></i></div>

    <div class="ns-hud" id="ns-hud" hidden>
      <div class="ns-top">
        <div class="ns-power" id="ns-power"><span>🔋 POWER</span><b id="ns-hp">100%</b><i><u id="ns-hpbar"></u></i></div>
        <div class="ns-clock"><b id="ns-hour">12 AM</b><small id="ns-night">Night 1</small></div>
      </div>
      <div class="ns-prompt" id="ns-prompt"><div class="ns-text" id="ns-text"></div><i class="ns-timer"><u id="ns-timer"></u></i></div>
      <div class="ns-score"><b id="ns-score">0</b><small id="ns-combo"></small></div>
      <ol class="ns-players" id="ns-players"></ol>
      <div class="ns-kb" id="ns-kb">
        {rows.map((r) => <div>{[...r].map((k) => <button type="button" data-k={k}>{k}</button>)}</div>)}
        <div><button type="button" data-k=" " class="space">space</button></div>
      </div>
    </div>
    <div class="ns-pop" id="ns-pop"></div>
    <div class="ns-banner" id="ns-banner"></div>
    <div class="ns-jump" id="ns-jump"></div>
    <div class="ns-spec" id="ns-spec" hidden><span id="ns-spec-txt">💀 You got caught! Watching the others…</span><button id="ns-skip" class="btn" type="button">⏩ Results</button></div>
    <button id="ns-fs" class="btn fs-btn" type="button" aria-label="Full screen">⛶</button>
    <div id="ns-tools" class="ns-tools" hidden><button id="ns-mute" class="btn" type="button" aria-label="Sound">🔊</button><button id="ns-leave" class="btn" type="button">🚪 Leave</button></div>

    <div id="ns-menu" class="ns-panel">
      <div class="ns-card">
        <h2 class="ns-title">Night Shift</h2>
        <p class="ns-sub">Type to survive until <b>6 AM</b></p>
        <div id="ns-joinbox" class="ns-join" hidden><span>📨 A friend invited you to their shift!</span><button id="ns-join" class="btn gold" type="button">Join the room</button></div>
        <div class="ns-modes">
          <button class="ns-mode hot" data-ns="rooms" type="button"><b>🌐 Online Rooms</b><small>See open rooms, join one or create yours (up to {MAX_PLAYERS} players)</small></button>
          <button class="ns-mode" data-ns="rbots" type="button"><b>⚔️ Rounds vs Bots</b><small>Same words for everyone. The slowest loses a ❤️</small></button>
          <button class="ns-mode" data-ns="bots" type="button"><b>🤖 Survival vs Bots</b><small>You + 3 bots. Who survives the night?</small></button>
          <button class="ns-mode" data-ns="solo" type="button"><b>🔦 Survival Solo</b><small>Just you and the animatronics</small></button>
        </div>
        <div class="ns-opts">
          <label><input type="checkbox" id="ns-opt-scare" checked /> 😱 Jumpscares</label>
          <label><input type="checkbox" id="ns-opt-hint" checked /> 💡 Show next key</label>
        </div>
        <p id="ns-best" class="ns-bestline"></p>
        <div class="ns-how"><span>⌨️ Type the text on the screen</span><span>❌ Mistakes drain power</span><span>⏰ Too slow? Power drops</span><span>🖱️ Drag: look around</span></div>
      </div>
    </div>

    <div id="ns-rooms" class="ns-panel" hidden>
      <div class="ns-card">
        <h2 class="ns-title small">Online Rooms</h2>
        <p class="ns-sub">Join an open office or create your own</p>
        <ol id="ns-roomlist" class="ns-roomlist"></ol>
        <h3 class="ns-h3">Create a room</h3>
        <div class="ns-newmode">
          <button type="button" class="on" data-newmode="rounds"><b>⚔️ Rounds</b><small>Everyone types the same word. Slowest loses a heart. Most hearts wins. ~5-15 min</small></button>
          <button type="button" data-newmode="surv"><b>🔦 Survival</b><small>Everyone types their own prompts. Last one standing wins</small></button>
        </div>
        <div class="ns-btns"><button id="ns-create" class="btn play" type="button">➕ Create room</button><button id="ns-quick" class="btn gold" type="button">⚡ Quick join</button><button id="ns-rooms-back" class="btn" type="button">Back</button></div>
      </div>
    </div>

    <div id="ns-lobby" class="ns-panel" hidden>
      <div class="ns-card">
        <h2 class="ns-title small">The Office</h2>
        <p id="ns-lobby-txt" class="ns-sub">Waiting for players…</p>
        <p id="ns-lobby-mode" class="ns-modeline"></p>
        <div id="ns-invite" class="ns-invite" hidden><input id="ns-link" readonly aria-label="Room link" /><button id="ns-copy" class="btn primary" type="button">📤 Copy link</button></div>
        <ol id="ns-slots" class="ns-slots"></ol>
        <label id="ns-botsbox" class="ns-opts" hidden><input type="checkbox" id="ns-bots" checked /> 🤖 Fill empty seats with bots</label>
        <div class="ns-btns"><button id="ns-start" class="btn play" type="button" hidden>▶️ Start the night</button><button id="ns-cancel" class="btn" type="button">Cancel</button></div>
      </div>
    </div>

    <div id="ns-over" class="ns-panel" hidden>
      <div class="ns-card">
        <div id="ns-res"></div>
        <ol id="ns-stand" class="ns-slots ns-stand"></ol>
        <div class="ns-btns"><button id="ns-again" class="btn play" type="button">🔄 Play again</button><button id="ns-back" class="btn" type="button">🏠 Menu</button></div>
      </div>
    </div>
  </div>

  <section class="neu box prose" style="margin-top:28px">
    <h2>How to play Night Shift</h2>
    <ol>
      <li>Words, phrases and sentences appear on your security monitor. Type them exactly (capital letters don't matter). On a phone, tap the keyboard on the screen.</li>
      <li>Every wrong key drains your <b>power</b> and makes the lights flicker. If a prompt takes too long, you lose a big chunk of power. Finishing a prompt without mistakes recharges you.</li>
      <li>The less power you have, the closer your animatronic walks to your desk. At 0% the lights go out… and it gets you.</li>
      <li>Every in-game hour lasts {HOUR / 1000} seconds. Survive from 12 AM to 6 AM to finish a night, then the next night is faster. Nights never end: how far can you go?</li>
      <li>Play solo, against 3 bots, or online with up to {MAX_PLAYERS} players. You can see everyone in the room, drag to look around, and watch the others after you get caught.</li>
      <li><b>Rounds mode:</b> every round everybody gets the same word or sentence. Whoever finishes last (or runs out of time) gets visited by their animatronic and loses a ❤️. Everyone starts with 5 hearts; the player with the most hearts at the end wins. Matches are quick: never more than 15 minutes.</li>
      <li>Open <b>Online Rooms</b> to see every open room, join one, or create your own (Rounds or Survival) and share the link with friends.</li>
    </ol>
    <p>Meet the night crew: 🐻 Bibi Bear, 🟨 Noobtronic, 👤 Guest 666 and 🥓 Bacon Bot. They only want to party. Forever.</p>
    <p class="small muted">Fan-made game inspired by the five-nights horror classics and Roblox. Names are random, there is no chat.</p>
  </section>

  <style is:global>
    .ns { --danger: 0; position: relative; height: min(84vh, 800px); min-height: 520px; border-radius: 20px; overflow: hidden; background: #040306; box-shadow: var(--neu-lg); touch-action: none; user-select: none; -webkit-user-select: none; }
    #ns-canvas { width: 100%; height: 100%; display: block; cursor: grab; }
    .ns-fx, .ns-fx i { position: absolute; inset: 0; pointer-events: none; }
    .ns-grain { inset: -50% !important; opacity: 0.09; background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='220' height='220'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>"); animation: ns-grain 0.5s steps(5) infinite; }
    @keyframes ns-grain { 20% { transform: translate(-6%, 4%); } 40% { transform: translate(5%, -7%); } 60% { transform: translate(-3%, 8%); } 80% { transform: translate(7%, 2%); } }
    .ns-lines { background: repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.22) 0 1px, transparent 1px 3px); mix-blend-mode: multiply; }
    .ns-danger { background: radial-gradient(ellipse at center, transparent 40%, rgba(0, 0, 0, 0.7) 85%), radial-gradient(ellipse at center, transparent 35%, rgba(200, 0, 20, calc(var(--danger) * 0.65)) 100%); }
    .ns.low .ns-danger { animation: ns-pulse 0.9s ease-in-out infinite; }
    @keyframes ns-pulse { 50% { opacity: 0.65; } }
    .ns-static { opacity: 0; background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='turbulence' baseFrequency='1.4' numOctaves='1'/><feColorMatrix type='saturate' values='0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>"); }
    .ns-static.go { animation: ns-static 0.45s steps(4); }
    .ns-static.on { opacity: 0.85; animation: ns-grain 0.3s steps(3) infinite; }
    @keyframes ns-static { 0% { opacity: 0.75; } 100% { opacity: 0; transform: translateX(3%); } }
    .ns-hud { position: absolute; inset: 0; pointer-events: none; font-family: 'VT323', ui-monospace, monospace; }
    .ns-top { position: absolute; top: 10px; left: 10px; right: 60px; display: flex; justify-content: space-between; gap: 10px; align-items: flex-start; }
    .ns-power, .ns-clock, .ns-score { padding: 6px 12px; border-radius: 10px; background: rgba(5, 5, 10, 0.72); border: 1px solid rgba(124, 255, 138, 0.25); color: #b9ffc2; text-shadow: 0 0 8px rgba(124, 255, 138, 0.6); }
    .ns-power { display: grid; grid-template-columns: auto auto; gap: 0 10px; align-items: center; min-width: 170px; }
    .ns-power span { font-size: 18px; }
    .ns-power b { font-size: 26px; text-align: right; }
    .ns-power i { grid-column: 1 / -1; height: 8px; border-radius: 2px; background: rgba(255, 255, 255, 0.1); overflow: hidden; }
    .ns-power u { display: block; height: 100%; width: 100%; background: linear-gradient(90deg, #ff3b30, #ffd23f 35%, #7cff8a 70%); background-size: 170px 100%; transition: width 0.25s; }
    .ns-power.low { color: #ff6b6b; border-color: rgba(255, 60, 60, 0.6); text-shadow: 0 0 10px #ff2020; animation: ns-blink 0.7s steps(2) infinite; }
    @keyframes ns-blink { 50% { opacity: 0.55; } }
    .ns-clock { text-align: right; display: grid; }
    .ns-clock b { font-size: 34px; line-height: 1; }
    .ns-clock small { font-size: 18px; opacity: 0.8; }
    .ns-score { position: absolute; top: 76px; right: 10px; text-align: right; display: grid; min-width: 100px; }
    .ns-score b { font-size: 30px; line-height: 1; }
    .ns-score small { font-size: 18px; color: #ffd23f; text-shadow: 0 0 8px #ff9800; min-height: 1em; }
    .ns-score small.pop { animation: ns-combo 0.3s ease; }
    @keyframes ns-combo { 50% { transform: scale(1.4); } }
    .ns-prompt { position: absolute; left: 50%; top: 13%; translate: -50% 0; width: min(780px, calc(100% - 24px)); padding: 14px 20px 12px; border-radius: 14px; background: rgba(2, 10, 4, 0.82); border: 2px solid rgba(124, 255, 138, 0.35); box-shadow: 0 0 40px rgba(60, 255, 120, 0.15), inset 0 0 30px rgba(60, 255, 120, 0.08); text-align: center; }
    .ns-text { font-size: clamp(26px, 4.4vw, 46px); line-height: 1.15; letter-spacing: 0.04em; word-break: break-word; min-height: 1.2em; }
    .ns-text span { color: rgba(185, 255, 194, 0.38); transition: color 0.08s; white-space: pre-wrap; }
    .ns-text span.ok { color: #7cff8a; text-shadow: 0 0 12px rgba(124, 255, 138, 0.9); }
    .ns-text span.cur { color: #fff; border-bottom: 3px solid #7cff8a; animation: ns-caret 0.8s steps(2) infinite; }
    .ns-text span.space.cur { background: rgba(124, 255, 138, 0.25); }
    @keyframes ns-caret { 50% { border-color: transparent; } }
    .ns-text span.bad { color: #ff4040 !important; text-shadow: 0 0 14px #ff0000; border-color: #ff4040; }
    .ns-prompt.err { animation: ns-shake 0.28s linear; border-color: #ff4040; box-shadow: 0 0 40px rgba(255, 0, 0, 0.4); }
    .ns-prompt.err .ns-text { text-shadow: -3px 0 rgba(255, 0, 80, 0.8), 3px 0 rgba(0, 220, 255, 0.8); }
    @keyframes ns-shake { 20% { transform: translate(-8px, 2px) skewX(-4deg); } 40% { transform: translate(7px, -2px); } 60% { transform: translate(-5px, 1px) skewX(3deg); } 80% { transform: translate(3px, 0); } }
    .ns-prompt.on { animation: ns-crt 0.45s cubic-bezier(0.2, 0.9, 0.3, 1.2); }
    @keyframes ns-crt { 0% { transform: scale(0.6, 0.02); filter: brightness(4); opacity: 0.2; } 45% { transform: scale(1, 0.04); filter: brightness(3); opacity: 1; } 100% { transform: none; filter: none; } }
    .ns-prompt.won { animation: ns-won 0.35s ease; }
    @keyframes ns-won { 40% { box-shadow: 0 0 60px rgba(124, 255, 138, 0.8); transform: scale(1.04); } }
    .ns-timer { display: block; height: 6px; margin-top: 10px; border-radius: 3px; background: rgba(255, 255, 255, 0.08); overflow: hidden; }
    .ns-timer u { display: block; height: 100%; width: 100%; background: #7cff8a; transform-origin: left; }
    .ns-timer u.hurry { background: #ff4040; box-shadow: 0 0 10px #ff0000; }
    .ns-players { position: absolute; left: 10px; top: 88px; list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; width: 190px; }
    .ns-players li { display: grid; grid-template-columns: 30px 1fr; gap: 2px 8px; align-items: center; padding: 5px 8px; border-radius: 10px; background: rgba(5, 5, 10, 0.7); color: #d8d8e8; font-size: 17px; line-height: 1; border: 1px solid transparent; transition: opacity 0.4s, transform 0.3s; }
    .ns-players li.me { border-color: rgba(124, 255, 138, 0.5); }
    .ns-players li.dead { opacity: 0.45; filter: grayscale(1); }
    .ns-players li.hit { animation: ns-shake 0.28s linear; border-color: #ff4040; }
    .ns-players svg { width: 30px; height: 30px; grid-row: span 2; }
    .ns-players b { font-weight: 400; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .ns-players i { height: 5px; border-radius: 3px; background: rgba(255, 255, 255, 0.12); overflow: hidden; }
    .ns-players i u { display: block; height: 100%; background: #7cff8a; transition: width 0.3s; }
    .ns-players li.lowhp i u { background: #ff4040; }
    .ns-kb { position: absolute; left: 50%; bottom: 10px; translate: -50% 0; display: grid; gap: 5px; pointer-events: auto; width: min(640px, calc(100% - 16px)); }
    .ns-kb div { display: flex; justify-content: center; gap: 5px; }
    .ns-kb button { flex: 1; max-width: 52px; height: clamp(34px, 6vh, 46px); border: 0; border-radius: 7px; background: rgba(20, 22, 30, 0.82); color: #c9cbd6; font: 22px 'VT323', monospace; text-transform: uppercase; box-shadow: 0 3px 0 rgba(0, 0, 0, 0.7), inset 0 1px 0 rgba(255, 255, 255, 0.08); cursor: pointer; transition: transform 0.06s, background 0.12s; touch-action: manipulation; }
    .ns-kb button.space { max-width: 320px; flex: 0 1 320px; text-transform: none; }
    .ns-kb button.next { box-shadow: 0 3px 0 rgba(0, 0, 0, 0.7), 0 0 0 2px rgba(124, 255, 138, 0.55), 0 0 14px rgba(124, 255, 138, 0.35); color: #fff; }
    .ns-kb button.ok { background: #1f7a3a; color: #fff; transform: translateY(3px); box-shadow: 0 0 0 rgba(0, 0, 0, 0.7), 0 0 16px rgba(124, 255, 138, 0.7); }
    .ns-kb button.bad { background: #a11; color: #fff; transform: translateY(3px); box-shadow: 0 0 18px rgba(255, 0, 0, 0.8); animation: ns-shake 0.25s linear; }
    .ns-pop { position: absolute; left: 50%; top: 28%; pointer-events: none; font: 700 26px 'VT323', monospace; color: #7cff8a; text-shadow: 0 0 10px #3cff6a; opacity: 0; }
    .ns-pop.go { animation: ns-up 0.9s ease-out; }
    @keyframes ns-up { 0% { opacity: 1; transform: translate(-50%, 10px) scale(0.8); } 100% { opacity: 0; transform: translate(-50%, -50px) scale(1.2); } }
    .ns-banner { position: absolute; top: 38%; left: 50%; translate: -50% -50%; text-align: center; opacity: 0; width: 92%; pointer-events: none; display: grid; }
    .ns-banner b { font: 400 clamp(2.4rem, 9vw, 5rem) 'Creepster', var(--fun); color: #f2f2f2; letter-spacing: 0.05em; text-shadow: 0 0 24px rgba(255, 30, 30, 0.6), 0 6px 0 #000; }
    .ns-banner span { font: 400 clamp(1.2rem, 3.5vw, 1.8rem) 'VT323', monospace; color: #ffd23f; text-shadow: 0 0 10px #000; }
    .ns-banner.go { animation: ns-banner 2.8s ease both; }
    @keyframes ns-banner { 0% { opacity: 0; filter: blur(8px); transform: scale(1.4); } 12% { opacity: 1; filter: none; transform: scale(1); } 16% { opacity: 0.3; } 20%, 78% { opacity: 1; } 100% { opacity: 0; transform: scale(0.95); } }
    .ns-jump { position: absolute; inset: 0; pointer-events: none; opacity: 0; background: radial-gradient(ellipse at center, transparent 30%, rgba(160, 0, 0, 0.85)); }
    .ns-jump.go { animation: ns-jump 1.6s ease-out; }
    @keyframes ns-jump { 0%, 10% { opacity: 1; background-color: rgba(255, 0, 0, 0.35); } 100% { opacity: 0; } }
    .ns.spec .ns-kb, .ns.spec .ns-prompt { display: none; }
    .ns.intro .ns-kb, .ns.intro .ns-players, .ns.intro .ns-score { opacity: 0; transform: translateY(30px); }
    .ns-kb, .ns-players, .ns-score { transition: opacity 0.6s, transform 0.6s cubic-bezier(0.2, 0.9, 0.3, 1.2); }
    .ns.shake #ns-canvas { animation: ns-shake 0.12s linear infinite; }
    .ns-spec { position: absolute; left: 50%; bottom: 14px; translate: -50% 0; display: flex; gap: 10px; align-items: center; padding: 8px 10px 8px 16px; border-radius: 14px; background: rgba(10, 5, 8, 0.85); color: #ffb3b3; font: 20px 'VT323', monospace; z-index: 4; }
    .ns-tools { position: absolute; right: 10px; bottom: 10px; display: flex; flex-direction: column; gap: 8px; z-index: 3; }
    .ns-tools .btn { padding: 8px 10px; font-size: 14px; }
    .ns-panel { position: absolute; inset: 0; display: grid; place-items: center; background: radial-gradient(ellipse at center, rgba(4, 3, 6, 0.2), rgba(4, 3, 6, 0.85)); z-index: 5; }
    .ns-card { width: min(560px, calc(100% - 28px)); max-height: calc(100% - 24px); overflow: auto; text-align: center; padding: 22px; border-radius: 18px; background: rgba(12, 10, 16, 0.9); border: 1px solid rgba(255, 255, 255, 0.07); backdrop-filter: blur(8px); box-shadow: 0 30px 80px rgba(0, 0, 0, 0.7), 0 0 60px rgba(160, 0, 30, 0.15); animation: ns-in 0.6s ease; }
    @keyframes ns-in { 0% { opacity: 0; filter: brightness(3); transform: scaleY(0.02); } 40% { opacity: 1; transform: scaleY(0.04); } 100% { transform: none; filter: none; } }
    .ns-title { font: 400 clamp(3rem, 11vw, 4.6rem)/1 'Creepster', var(--fun); color: #e9e9e9; margin: 0; letter-spacing: 0.04em; text-shadow: 0 0 30px rgba(255, 30, 40, 0.55), 0 5px 0 #3a0008; animation: ns-flick 4s infinite; }
    .ns-title.small { font-size: 2.6rem; }
    @keyframes ns-flick { 0%, 18%, 22%, 62%, 64%, 100% { opacity: 1; } 20%, 63% { opacity: 0.35; } }
    .ns-sub { font: 22px 'VT323', monospace; color: #b9ffc2; margin: 6px 0 14px; }
    .ns-sub b { color: #ffd23f; font-weight: 400; }
    .ns-modes { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .ns-mode { display: grid; gap: 3px; text-align: left; padding: 12px 14px; border: 1px solid rgba(255, 255, 255, 0.07); border-radius: 14px; cursor: pointer; background: #17141d; color: var(--head); box-shadow: 0 4px 0 #050407; transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s; }
    .ns-mode b { font: 700 1.05rem var(--fun); }
    .ns-mode small { color: var(--muted); font-size: 12px; line-height: 1.3; }
    .ns-mode:hover { transform: translateY(-3px); border-color: rgba(255, 60, 70, 0.5); box-shadow: 0 7px 0 #050407, 0 0 24px rgba(255, 40, 60, 0.25); }
    .ns-mode.hot { background: linear-gradient(135deg, #5a0a18, #2a0610); border-color: rgba(255, 60, 70, 0.5); }
    .ns-mode.hot small { color: #ffc2c8; }
    .ns-opts { display: flex; gap: 8px 18px; justify-content: center; flex-wrap: wrap; margin: 14px 0 4px; font-size: 14px; color: var(--text); }
    .ns-opts input { accent-color: #e0313f; }
    .ns-bestline { font: 20px 'VT323', monospace; color: #ffd23f; margin: 8px 0 0; min-height: 1em; }
    .ns-how { display: flex; flex-wrap: wrap; gap: 6px 14px; justify-content: center; margin-top: 12px; font-size: 12px; color: var(--muted); }
    .ns-join { display: flex; gap: 10px; align-items: center; justify-content: center; flex-wrap: wrap; margin-bottom: 12px; padding: 10px; border-radius: 12px; background: rgba(255, 204, 51, 0.1); color: var(--gold); font-weight: 600; }
    .ns-invite { display: flex; gap: 8px; margin: 4px 0 12px; }
    .ns-invite input { flex: 1; min-width: 0; padding: 10px; border-radius: 12px; border: 0; background: #17141d; color: var(--head); }
    .ns-slots { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(110px, 1fr)); gap: 8px; }
