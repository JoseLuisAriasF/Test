---
import Base from '../layouts/Base.astro';
import { games } from '../lib/data.js';
const shots = games.reduce((n, g) => n + g.thumbs.length, 0);
---
<Base title="RoGuessr: Roblox Guessing Game - Ranked, Battles & Avatars" description={`GeoGuessr for Roblox! Screenshots, pixel icons, higher-or-lower, trivia, codes and badges. Mix your own match, battle friends live and climb Ranked from Bronze to Legend. ${shots}+ screenshots, free and unlimited.`}>
  <section class="hero" style="padding-bottom:8px">
    <span class="pill"><i class="dot"></i>Ranked · Live battles · 6 game modes</span>
    <h1><span class="grad">RoGuessr</span>: how well do you know Roblox?</h1>
    <p>Screenshots, pixel icons, higher-or-lower, trivia, codes and badges. Mix them your way, battle friends live and climb to Legend!</p>
  </section>

  <div class="rg neu">
    <div id="challenge" class="rg-banner" hidden>
      <span>⚔️ <b>A friend challenged you!</b> They scored <b id="ch-score"></b>. Same rounds - can you beat them?</span>
      <button class="btn gold" id="ch-go" type="button">Accept challenge</button>
    </div>

    <div id="menu">
      <div id="profile" class="rg-profile"></div>
      <div class="tiles" style="margin-top:16px">
        <button class="tile t-ranked" id="play-ranked" type="button"><b>🏆 Ranked</b><span>Post a 1v1 challenge or accept one · climb to Legend</span><i>🏆</i></button>
        <button class="tile t2" id="play-quick" type="button"><b>⚔️ Quick Match</b><span>Casual battle vs real players · all modes</span><i>⚔️</i></button>
      </div>

      <h3 class="rg-h">🎮 Solo</h3>
      <div class="tiles">
        <button class="tile t1" data-preset="classic" type="button"><b>🎯 Classic</b><span>5 screenshots</span><small data-best="classic"></small><i>📸</i></button>
        <button class="tile t3" data-preset="daily" type="button"><b>📅 Daily</b><span>Same 5 for everyone</span><small data-best="daily"></small><i>📅</i></button>
        <button class="tile t4" data-preset="endless" type="button"><b>♾️ Endless</b><span>All modes · 3 lives</span><small data-best="endless"></small><i>♾️</i></button>
      </div>

      <h3 class="rg-h">🎛️ Build your own match</h3>
      <div class="rg-custom">
        <div id="cfg-types" class="rg-chips"></div>
        <div class="rg-row"><span>Rounds</span><div id="cfg-rounds" class="seg"></div></div>
        <div class="rg-row"><span>Timer</span><div id="cfg-time" class="seg"></div></div>
        <div class="rg-row"><button id="custom-solo" class="btn primary" type="button">▶ Play solo</button><button id="custom-room" class="btn gold" type="button">👥 Create room for friends</button></div>
      </div>
      <form id="join" class="search" style="margin-top:14px;padding:6px 6px 6px 16px"><input id="join-code" maxlength="5" placeholder="Have a room code? Type it here" aria-label="Room code" autocomplete="off" style="text-transform:uppercase" /><button class="btn" type="submit">Join</button></form>
    </div>

    <div id="ranked" hidden>
      <div class="rg-row" style="justify-content:space-between;margin-bottom:12px"><h2 style="margin:0">🏆 Ranked challenges</h2><button id="ranked-back" class="btn" type="button">← Menu</button></div>
      <div class="rg-custom">
        <b style="font-family:var(--fun);color:var(--head)">⚔️ Post a challenge - pick the modes you're best at</b>
        <div id="rcfg-types" class="rg-chips"></div>
        <div class="rg-row"><span>Rounds</span><div id="rcfg-rounds" class="seg"></div></div>
        <div class="rg-row"><span>Timer</span><div id="rcfg-time" class="seg"></div></div>
        <div class="rg-row"><button id="ranked-create" class="btn gold" type="button">📣 Post challenge</button><span class="small muted">Anyone can accept it. The battle starts right away.</span></div>
      </div>
      <h3 class="rg-h">🔥 Open challenges <span id="ranked-count" class="pill">0</span></h3>
      <div id="ranked-list" class="rk-list"></div>
    </div>

    <div id="lobby" hidden style="text-align:center">
      <p class="small muted" style="margin:0">Room code</p>
      <p class="rg-code" id="lobby-code"></p>
      <div id="lobby-cfg" class="rg-chips" style="justify-content:center;margin-bottom:10px"></div>
      <div id="radar" class="radar" hidden aria-hidden="true"><i></i><i></i><i></i><span>🔎</span></div>
      <p id="lobby-status" class="muted"></p>
      <div id="lobby-players" class="rg-lobby"></div>
      <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:18px">
        <button id="lobby-start" class="btn play" type="button">▶ Start battle</button>
        <button id="lobby-invite" class="btn" type="button">📤 Invite friends</button>
        <button id="lobby-reroll" class="btn" type="button">🎲 New name</button>
        <button id="lobby-leave" class="btn" type="button">Leave</button>
      </div>
    </div>

    <div id="game" hidden>
      <div id="rivals" class="rg-rivals"></div>
      <div class="rg-hud"><span id="round"></span><span id="lives"></span><span>⭐ <b id="score">0</b></span></div>
      <p id="q" class="rg-q"></p>
      <div id="stage" class="rg-view">
        <div id="media" class="rg-media"></div>
        <svg class="rg-timer" viewBox="0 0 36 36" aria-hidden="true"><circle r="15.9" cx="18" cy="18" /><circle id="ring" r="15.9" cx="18" cy="18" /></svg>
        <span id="secs" class="rg-secs"></span>
        <div id="pop" class="rg-pop"></div>
        <div id="intro" class="rg-intro" hidden></div>
        <div id="count" class="rg-count" hidden></div>
        <button id="hint" class="btn rg-zoom" type="button"></button>
      </div>
      <div id="opts" class="rg-opts"></div>
      <div id="after" class="rg-after" hidden>
        <span><b id="verdict"></b><br /><span id="info" class="small muted"></span></span>
        <span style="display:flex;gap:10px;flex-wrap:wrap"><a id="codes" class="btn gold" target="_blank"></a><button id="next" class="btn primary" type="button">Next →</button></span>
      </div>
    </div>

    <div id="over" hidden style="text-align:center;padding:10px 0">
      <p class="pill" style="margin:0 auto" id="over-mode"></p>
      <div id="podium" class="rg-podium" hidden></div>
      <h2 id="over-rank" style="font-size:2rem;margin:14px 0 4px"></h2>
      <p class="num" style="font-size:3rem;margin:0" id="over-score"></p>
      <div id="elo" class="rg-elo" hidden></div>
      <div id="unlocks" class="rg-unlocks" hidden></div>
      <p class="muted" id="over-best"></p>
      <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin:16px 0">
        <button id="again" class="btn primary" type="button">🔄 Play again</button>
        <button id="dare" class="btn gold" type="button">⚔️ Challenge a friend</button>
        <button id="share" class="btn" type="button">📤 Share</button>
        <button id="back" class="btn" type="button">🏠 Menu</button>
      </div>
      <p class="small muted">Games you saw:</p>
      <div id="seen" class="chips" style="justify-content:center"></div>
    </div>
  </div>
  <canvas id="confetti" aria-hidden="true"></canvas>

  <style is:global>
    .rg { max-width: 920px; margin: 0 auto; padding: 18px; }
    .rg .tile { border: 0; text-align: left; cursor: pointer; font: inherit; }
    .rg .tile small { display: block; margin-top: 8px; font-weight: 700; }
    .rg-h { margin: 26px 0 12px; }
    .rg-pc { display: flex; gap: 16px; align-items: center; padding: 16px; border-radius: 18px; box-shadow: var(--neu); flex-wrap: wrap; }
    /* Ranked tile: rotating conic border (registered --ang from global.css) */
    .t-ranked { background: linear-gradient(135deg, #1b1f2c, #2a1f3d) padding-box, conic-gradient(from var(--ang), #ffcc33, #ff5fa2, #6d7ff0, #3cc8ff, #ffcc33) border-box; border: 3px solid transparent !important; animation: ang 3s linear infinite; }
    .t-ranked b { background: linear-gradient(90deg, #ffcc33, #ff5fa2); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .rg-custom { padding: 16px; border-radius: 18px; box-shadow: var(--inset); display: grid; gap: 12px; }
    .rg-chips { display: flex; flex-wrap: wrap; gap: 8px; }
    .rg-chip { padding: 8px 14px; border-radius: 999px; border: 0; font: 600 14px var(--fun); background: #262c3a; color: var(--muted); cursor: pointer; transition: transform 0.15s, background 0.2s; }
    button.rg-chip:hover { transform: translateY(-2px); }
    .rg-chip.on { background: var(--brand); color: #fff; box-shadow: 0 4px 14px rgba(184, 108, 245, 0.35); }
    .rg-row { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
    .rg-row > span { font: 600 14px var(--fun); color: var(--head); min-width: 60px; }
    .seg { display: inline-flex; padding: 4px; border-radius: 12px; background: var(--bg-2); box-shadow: var(--inset); }
    .seg button { border: 0; background: none; color: var(--muted); font: 600 14px var(--fun); padding: 6px 14px; border-radius: 9px; cursor: pointer; }
    .seg button.on { background: var(--accent); color: #fff; }
    .rg-banner { display: flex; gap: 12px; align-items: center; justify-content: space-between; flex-wrap: wrap; padding: 14px 16px; margin-bottom: 16px; border-radius: 16px; background: linear-gradient(90deg, rgba(255, 138, 61, 0.2), rgba(255, 95, 162, 0.2)); }
    .rg-code { font: 700 clamp(2.4rem, 9vw, 3.6rem) / 1.1 var(--fun); letter-spacing: 0.18em; margin: 4px 0 10px; background: var(--brand); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .radar { position: relative; width: 120px; height: 120px; margin: 6px auto 10px; display: grid; place-items: center; }
    .radar span { font-size: 2.4rem; animation: fx-float 1.6s ease-in-out infinite; }
    .radar i { position: absolute; inset: 0; border-radius: 50%; border: 3px solid var(--accent); animation: radar 2.4s ease-out infinite; opacity: 0; }
    .radar i:nth-child(2) { animation-delay: 0.8s; border-color: var(--pink); } .radar i:nth-child(3) { animation-delay: 1.6s; border-color: var(--gold); }
    @keyframes radar { from { transform: scale(0.2); opacity: 1; } to { transform: scale(1); opacity: 0; } }
    .rk-list { display: grid; gap: 12px; }
    .rk-card { display: flex; gap: 14px; align-items: center; padding: 12px 14px; border-radius: 18px; box-shadow: var(--neu); animation: rg-join 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) both; flex-wrap: wrap; }
    .rk-card .grow { flex: 1; min-width: 200px; }
    .rk-card .grow b { color: var(--head); font-family: var(--fun); }
    .rk-card .btn.play { animation: rg-glow 2.4s ease-in-out infinite; }
    @keyframes rg-glow { 50% { box-shadow: 0 4px 0 #1f8a5a, 0 0 18px rgba(62, 207, 142, 0.5); } }
    .rg-lobby { display: flex; flex-wrap: wrap; gap: 14px; justify-content: center; }
    .rg-player { display: flex; flex-direction: column; align-items: center; gap: 6px; width: 130px; padding: 12px 6px; border-radius: 16px; box-shadow: var(--neu); animation: rg-join 0.5s cubic-bezier(0.34, 1.56, 0.64, 1); font-size: 13px; }
    .rg-player.me { outline: 2px solid var(--accent); }
    @keyframes rg-join { from { transform: scale(0.3) rotate(-10deg); opacity: 0; } }
    .rg-rivals { display: grid; gap: 6px; margin-bottom: 12px; }
    .rg-rival { display: grid; grid-template-columns: 30px minmax(0, 150px) 1fr 80px; gap: 8px; align-items: center; font-size: 13px; }
    .rg-rival .ra { height: 34px; overflow: hidden; }
    .rg-rival .nm { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .rg-rival .bar { height: 12px; }
    .rg-rival .bar i { transition: width 0.8s cubic-bezier(0.22, 1, 0.36, 1); background: var(--brand); }
    .rg-rival.me .bar i { background: linear-gradient(90deg, var(--green), var(--cyan)); }
    .rg-rival .pts { text-align: right; font: 600 13px var(--fun); color: var(--head); }
    .rg-rival.flash { animation: rg-flash 0.6s; }
    @keyframes rg-flash { 40% { transform: scale(1.04); filter: brightness(1.4); } }
    .rg-hud { display: flex; justify-content: space-between; font: 600 16px var(--fun); color: var(--head); margin-bottom: 6px; }
    .rg-q { font: 600 clamp(1.1rem, 3.5vw, 1.5rem) var(--fun); color: var(--head); text-align: center; margin: 4px 0 12px; }
    .rg-view { position: relative; aspect-ratio: 16 / 9; border-radius: 18px; overflow: hidden; background: radial-gradient(circle at 50% 40%, #252b3b, var(--bg-2)); box-shadow: var(--inset); view-transition-name: stage; }
    .rg-media { position: absolute; inset: 0; display: grid; place-items: center; }
    .rg-pan { width: 100%; height: 100%; animation: rg-pan 14s ease-in-out infinite alternate; }
    @keyframes rg-pan { to { transform: translate(-3%, 2%); } }
    #shot { width: 100%; height: 100%; object-fit: cover; transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.3s; opacity: 0; }
    #shot.ready { opacity: 1; }
    #pix { height: 82%; aspect-ratio: 1; border-radius: 22px; image-rendering: pixelated; box-shadow: var(--neu-lg); animation: rg-in 0.4s; }
    .duo { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 4%; width: 92%; }
    .duo-card { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 14px 8px; border: 0; border-radius: 18px; background: #262c3a; color: var(--head); font: 600 15px var(--fun); cursor: pointer; box-shadow: 0 5px 0 #0d1017; transition: transform 0.15s; animation: duo-in 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both; animation-delay: calc(var(--d) * 0.12s); }
    .duo-card:nth-of-type(1) { --from: -60px; } .duo-card:nth-of-type(2) { --from: 60px; }
    @keyframes duo-in { from { transform: translateX(var(--from, 0)) scale(0.7); opacity: 0; } }
    .duo-card:hover:not(:disabled) { transform: translateY(-4px) scale(1.03); }
    .duo-card img { width: min(120px, 22vw); aspect-ratio: 1; border-radius: 16px; }
    .duo-card .val { font: 700 1.4rem var(--fun); color: var(--gold); }
    .duo-card.right { background: var(--green); color: #0b1a12; box-shadow: 0 5px 0 #1f8a5a; }
    .duo-card.wrong { background: var(--red); box-shadow: 0 5px 0 #a3303a; }
    .vs { font: 700 clamp(1.4rem, 5vw, 2.4rem) var(--fun); background: linear-gradient(135deg, #ffcc33, #ff5fa2); -webkit-background-clip: text; background-clip: text; color: transparent; animation: vs 1s ease-in-out infinite; }
    @keyframes vs { 50% { transform: scale(1.25) rotate(-8deg); } }
    .tcard { display: flex; flex-direction: column; align-items: center; gap: 10px; animation: rg-in 0.4s; }
    .tcard img { width: min(170px, 34vw); border-radius: 26px; box-shadow: var(--neu-lg); animation: fx-float 3s ease-in-out infinite; }
    .tcard b { font: 600 1.3rem var(--fun); color: var(--head); }
    .ticket { display: grid; gap: 6px; text-align: center; padding: 22px 34px; border-radius: 18px; background: repeating-linear-gradient(45deg, #2a2f40 0 12px, #262b3a 12px 24px); border: 3px dashed var(--gold); animation: ticket 0.6s cubic-bezier(0.34, 1.56, 0.64, 1); max-width: 90%; }
    .ticket small { color: var(--gold); font: 600 13px var(--fun); letter-spacing: 0.1em; }
    .ticket kbd { font: 800 clamp(1.4rem, 5vw, 2.4rem) ui-monospace, monospace; color: var(--head); word-break: break-all; }
    .ticket span { color: var(--muted); font-size: 14px; }
    @keyframes ticket { from { transform: rotate(-12deg) scale(0.5); opacity: 0; } }
    .medal { display: grid; justify-items: center; gap: 8px; text-align: center; max-width: 90%; }
    .medal .m { font-size: clamp(3rem, 12vw, 5rem); animation: medal 2.4s ease-in-out infinite; filter: drop-shadow(0 6px 18px rgba(255, 204, 51, 0.5)); }
    .medal b { font: 600 clamp(1.2rem, 4vw, 1.8rem) var(--fun); color: var(--head); }
    @keyframes medal { 0%, 100% { transform: rotate(-10deg); } 50% { transform: rotate(10deg) scale(1.08); } }
    .rg-intro { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; z-index: 4; background: rgba(23, 27, 36, 0.7); backdrop-filter: blur(8px); }
    .rg-intro span { font-size: clamp(3rem, 12vw, 5rem); }
    .rg-intro b { font: 700 clamp(1.6rem, 6vw, 2.8rem) var(--fun); background: var(--brand); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .rg-intro.go > * { animation: intro 0.9s cubic-bezier(0.34, 1.56, 0.64, 1) both; }
    .rg-intro.go b { animation-delay: 0.08s; }
    @keyframes intro { 0% { transform: scale(0.2) rotateX(80deg); opacity: 0; } 35% { transform: scale(1.1); opacity: 1; } 80% { transform: scale(1); opacity: 1; } 100% { transform: scale(1.4); opacity: 0; } }
    .rg-count { position: absolute; inset: 0; display: grid; place-items: center; background: rgba(23, 27, 36, 0.82); backdrop-filter: blur(6px); font: 700 clamp(4rem, 16vw, 8rem) var(--fun); color: #fff; z-index: 5; }
    .rg-count span { animation: rg-num 0.8s cubic-bezier(0.34, 1.56, 0.64, 1); background: var(--brand); -webkit-background-clip: text; background-clip: text; color: transparent; }
    @keyframes rg-num { from { transform: scale(2.6) rotate(-12deg); opacity: 0; } }
    .rg-timer { position: absolute; top: 10px; right: 10px; width: 54px; height: 54px; transform: rotate(-90deg); z-index: 3; }
    .rg-timer circle { fill: rgba(23, 27, 36, 0.75); stroke: rgba(255, 255, 255, 0.15); stroke-width: 3; }
    .rg-timer #ring { fill: none; stroke: var(--green); stroke-dasharray: 100; stroke-linecap: round; transition: stroke 0.3s; }
    .rg-secs { position: absolute; top: 10px; right: 10px; width: 54px; height: 54px; display: grid; place-items: center; font: 700 17px var(--fun); color: #fff; z-index: 3; }
    .rg-secs.hurry { animation: rg-beat 0.5s infinite; color: var(--red); }
    @keyframes rg-beat { 50% { transform: scale(1.25); } }
    .rg-zoom { position: absolute; left: 10px; bottom: 10px; font-size: 13px; padding: 9px 14px; z-index: 3; }
    .rg-pop { position: absolute; inset: 0; display: grid; place-items: center; font: 700 clamp(2rem, 7vw, 3.6rem) var(--fun); color: #fff; text-shadow: 0 4px 18px rgba(0, 0, 0, 0.6); pointer-events: none; opacity: 0; z-index: 4; }
    .rg-opts { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 12px; margin-top: 14px; }
    .rg-opts .btn { padding: 16px; font-size: 16px; min-height: 58px; animation: rg-in 0.35s both; transition: opacity 0.3s, transform 0.3s; }
    .rg-opts .btn:nth-child(2) { animation-delay: 0.06s; } .rg-opts .btn:nth-child(3) { animation-delay: 0.12s; } .rg-opts .btn:nth-child(4) { animation-delay: 0.18s; }
    .rg-opts .btn.gone { opacity: 0; transform: scale(0.6); pointer-events: none; }
    .rg-opts .btn.right { --edge: #1f8a5a; background: var(--green); color: #0b1a12; animation: rg-flash 0.6s; }
    .rg-opts .btn.wrong { --edge: #a3303a; background: var(--red); color: #fff; }
    @keyframes rg-in { from { opacity: 0; transform: translateY(8px); } }
    .rg-after { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-top: 14px; padding: 12px 14px; border-radius: 14px; box-shadow: var(--inset); animation: rg-in 0.3s; }
    .rg-podium { display: flex; justify-content: center; align-items: flex-end; gap: 12px; margin: 26px 0 6px; min-height: 250px; }
    .rg-podium > div { width: 120px; display: flex; flex-direction: column; align-items: center; gap: 4px; font-size: 13px; }
    .rg-podium .step { width: 100%; border-radius: 14px 14px 4px 4px; display: grid; place-items: center; font: 700 1.6rem var(--fun); color: #fff; animation: rg-rise 0.9s cubic-bezier(0.34, 1.56, 0.64, 1) both; transform-origin: bottom; }
    .rg-podium .p1 .step { height: 110px; background: linear-gradient(#ffcc33, #e0a800); animation-delay: 0.6s; }
    .rg-podium .p2 .step { height: 78px; background: linear-gradient(#c9d1e0, #8a93a3); animation-delay: 0.3s; }
    .rg-podium .p3 .step { height: 54px; background: linear-gradient(#ff9a5a, #c9642a); }
    @keyframes rg-rise { from { transform: scaleY(0); } }
    .rg-elo { margin: 14px auto; padding: 14px; max-width: 360px; border-radius: 16px; box-shadow: var(--inset); display: grid; gap: 8px; justify-items: center; animation: rg-in 0.5s; }
    .elo-num { font: 700 2.2rem var(--fun); color: var(--head); }
    .elo-num b { font-size: 1.2rem; }
    .promo { font: 700 1.2rem var(--fun); padding: 6px 16px; border-radius: 999px; background: linear-gradient(90deg, #ffcc33, #ff5fa2); color: #2a1f00; animation: promo 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) 0.8s both; }
    .promo.demo { background: #3a2230; color: var(--red); }
    @keyframes promo { from { transform: scale(0) rotate(-20deg); } }
    .rg-unlocks { margin: 10px auto; max-width: 560px; }
    .unl { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
    .unl a { display: grid; padding: 10px 16px; border-radius: 14px; box-shadow: var(--neu); animation: rg-join 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both; animation-delay: calc(var(--k) * 0.12s + 0.4s); }
    #confetti { position: fixed; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 50; }
    ::view-transition-old(stage) { animation: vt-out 0.25s ease-in both; }
    ::view-transition-new(stage) { animation: vt-in 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) both; }
    @keyframes vt-out { to { opacity: 0; transform: translateX(-30px) scale(0.96); } }
    @keyframes vt-in { from { opacity: 0; transform: translateX(30px) scale(0.96); } }
    @media (max-width: 560px) { .rg-rival { grid-template-columns: 30px minmax(0, 90px) 1fr 70px; } .duo-card { font-size: 13px; padding: 10px 4px; } }
  </style>

  <script>
    import '../scripts/roguessr.ts';
  </script>
</Base>
