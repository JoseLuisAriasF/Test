---
import Base from '../../layouts/Base.astro';
import { CHARS, CHAR_IDS, MAPS, MODES, MEDALS, CALIBRATION, TIERS } from '../../lib/chase.js';
const heroes = [...new Set(CHAR_IDS.map((id) => CHARS[id].hero))];
---
<Base title="Blox Chase: Grand Chase-Style PvP Fighting Game Online (Roblox Style)" description="Free online PvP brawler inspired by Grand Chase with Roblox-style fighters. Create a room (1v1, 2v2, 3v3, free for all), pick one of 10 classes, master Korean dash and aim jumps, and climb the ranked medals from Stone to Mythic.">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bangers&display=swap" />
  <section class="hero" style="padding-bottom:10px">
    <span class="pill">⚔️ New · Online PvP</span>
    <h1><span class="grad">Blox Chase</span>: the PvP brawler</h1>
    <p>Grand Chase-style fights with your own Roblox-style avatar. Create a room, invite friends, pick a class and win to climb the medals.</p>
  </section>

  <div class="bc game menu" id="bc">
    <canvas id="bc-canvas" aria-label="Blox Chase fight"></canvas>
    <div class="bc-vignette" aria-hidden="true"></div>

    <div id="bc-hud" class="bc-hud" hidden>
      <div id="bc-cards" class="bc-cards"></div>
      <div id="bc-timer" class="bc-timer">3:00</div>
      <div id="bc-combo" class="bc-combo"></div>
      <div id="bc-skillbar" class="bc-skillbar"></div>
      <div id="bc-inputs" class="bc-inputs" hidden></div>
      <div id="bc-touch" class="bc-touch" aria-hidden="true">
        <div class="pad"><button data-k="U" type="button">▲</button><button data-k="L" type="button">◀</button><button data-k="D" type="button">▼</button><button data-k="R" type="button">▶</button></div>
        <div class="acts"><button data-k="A" class="big" type="button">Z</button><button data-k="K" type="button">Dash</button><button data-k="J" type="button">Jump</button><button data-k="X" type="button">Ctr</button><button data-k="G" type="button">Grab</button><button data-k="S1" class="sk" type="button">A</button><button data-k="S2" class="sk" type="button">S</button><button data-k="S3" class="sk" type="button">D</button></div>
      </div>
    </div>
    <div id="bc-nums" class="bc-nums" aria-hidden="true"></div>
    <div id="bc-cut" class="bc-cut" aria-hidden="true"></div>
    <div id="bc-banner" class="bc-banner" aria-live="polite"></div>
    <div class="bc-tools"><button id="bc-mute" class="btn" type="button" aria-label="Sound">🔊</button><button id="bc-leave" class="btn" type="button">🚪</button><button id="bc-fs" class="btn" type="button" aria-label="Full screen">⛶</button></div>

    <div id="bc-menu" class="bc-panel">
      <div class="bc-card bc-title-card">
        <h2 class="bc-logo">Blox<span>Chase</span></h2>
        <p class="bc-sub">{CHAR_IDS.length} classes · {MAPS.length} arenas · ranked medals</p>
        <div id="bc-me" class="bc-me"></div>
        <div class="bc-modes">
          <button id="bc-go-online" class="bc-mode hot" type="button"><b>🌐 Online Rooms</b><small>Create or join a room: 1v1, 2v2, 3v3 or free for all (up to 6)</small></button>
          <button id="bc-go-practice" class="bc-mode" type="button"><b>🤖 Practice</b><small>Fight the CPU or a training dummy to learn the combos</small></button>
          <a class="bc-mode" href="/chase/guide/"><b>🎬 PvP Tricks Guide</b><small>Korean dash, aim jump, counters… animated, step by step</small></a>
          <a class="bc-mode" href="#ranking"><b>🏆 Ranking</b><small>Medals from Stone to Mythic</small></a>
        </div>
        <p class="bc-keys"><kbd>←</kbd><kbd>→</kbd> move · <kbd>↑</kbd> jump · <kbd>↓</kbd> crouch · <kbd>↓</kbd>+<kbd>↑</kbd> drop · <kbd>Z</kbd> attack (hold = charge MP) · <kbd>→</kbd><kbd>→</kbd> dash (hold = sprint) · <kbd>C</kbd> counter · <kbd>←</kbd>+<kbd>→</kbd>+<kbd>Z</kbd> grab · <kbd>A</kbd><kbd>S</kbd><kbd>D</kbd> skills</p>
      </div>
    </div>

    <div id="bc-rooms" class="bc-panel" hidden>
      <div class="bc-card">
        <h2 class="bc-h2">Online Rooms</h2>
        <ol id="bc-roomlist" class="bc-roomlist"></ol>
        <h3 class="bc-h3">Create a room</h3>
        <div class="bc-row"><label>Mode <select id="bc-new-mode" class="btn"></select></label><label>Arena <select id="bc-new-map" class="btn"></select></label></div>
        <div class="bc-btns"><button id="bc-create" class="btn play" type="button">➕ Create room</button><button id="bc-quick" class="btn gold" type="button">⚡ Quick join</button><button id="bc-rooms-back" class="btn" type="button">Back</button></div>
      </div>
    </div>

    <div id="bc-lobby" class="bc-panel" hidden>
      <div class="bc-card bc-lobby">
        <div class="bc-pick">
          <h2 class="bc-h2">Choose your fighter</h2>
          <div id="bc-grid" class="bc-grid"></div>
          <div id="bc-detail" class="bc-detail"></div>
        </div>
        <div class="bc-room">
          <div class="only-online">
            <h3 id="bc-room-title" class="bc-h3"></h3>
            <div class="bc-invite"><input id="bc-link" readonly aria-label="Room link" /><button id="bc-copy" class="btn primary" type="button">📤 Copy link</button></div>
            <div id="bc-slots"></div>
            <div id="bc-hostcfg" class="bc-row"><label>Mode <select id="bc-cfg-mode" class="btn"></select></label><label>Arena <select id="bc-cfg-map" class="btn"></select></label></div>
            <p id="bc-lobby-txt" class="bc-note"></p>
            <div class="bc-btns"><button id="bc-team" class="btn" type="button">🔁 Switch team</button><button id="bc-start" class="btn play" type="button">⚔️ Start fight</button></div>
          </div>
          <div class="only-local">
            <h3 class="bc-h3">Practice</h3>
            <label class="bc-field">Arena <select id="bc-p-map" class="btn"></select></label>
            <label class="bc-field">Opponent <select id="bc-p-cpu" class="btn"></select></label>
            <label class="bc-field">Level <select id="bc-p-lvl" class="btn"></select></label>
            <div class="bc-btns"><button id="bc-fight" class="btn play" type="button">⚔️ Fight!</button></div>
          </div>
          <div class="bc-btns"><button id="bc-lobby-back" class="btn" type="button">Back</button></div>
        </div>
      </div>
    </div>

    <div id="bc-over" class="bc-panel" hidden>
      <div class="bc-card">
        <div id="bc-res"></div>
        <ol id="bc-stand" class="bc-stand"></ol>
        <div class="bc-btns"><button id="bc-again" class="btn play" type="button">🔄 Fight again</button><button id="bc-back" class="btn" type="button">🏠 Menu</button></div>
      </div>
    </div>
  </div>

  <section id="ranking" class="bc-ranking">
    <div class="sec-head"><div><h2>🏆 Ranked medals</h2><p>Win online fights to earn MMR. Beat stronger players for more points; new accounts are worth almost nothing, so smurfing doesn't pay.</p></div><a class="more" href="/chase/guide/">Get better →</a></div>
    <div class="bc-medals">
      {MEDALS.map((m) => <div class="neu" style={`--c:${m.c}`}><span>{m.e}</span><b>{m.name}</b><small>{m.min}+</small></div>)}
    </div>
    <div id="bc-rank" class="rows" style="margin-top:14px"><p class="muted center">Loading the ranking…</p></div>
  </section>

  <section class="neu box prose" style="margin-top:28px">
    <h2>How to play Blox Chase</h2>
    <ol>
      <li><b>Rooms like the classic:</b> open <b>Online Rooms</b>, create a room (1 vs 1, 2 vs 2, 3 vs 3 or free for all with up to 6 players) and share the link, or join any open room. Everyone picks a fighter; the host 👑 starts.</li>
      <li><b>Combos:</b> tap <kbd>Z</kbd> to chain your basic combo. The last hit launches or knocks down. Hit enemies in the air to juggle them.</li>
      <li><b>Dash:</b> double tap a direction (<kbd>→</kbd><kbd>→</kbd>), keep holding the second tap to sprint. Attack during a dash for a dash attack. Some classes can <b>dash-cancel</b> their attacks: that's the Korean dash.</li>
      <li><b>MP and skills:</b> the 3 blue bars fill over time and when you hit. Like the classic, hold <kbd>Z</kbd> to charge 1, 2 or 3 bars and release for that skill, or use the shortcuts <kbd>A</kbd> (1 bar), <kbd>S</kbd> (2 bars), <kbd>D</kbd> (3 bars, the super with a cinematic close-up).</li>
      <li><b>Grab:</b> like the classic, press the arrow towards someone you are touching + <kbd>Z</kbd> (or <kbd>←</kbd>+<kbd>→</kbd>+<kbd>Z</kbd>, or <kbd>V</kbd>) to throw them over your shoulder. Grabs go through super armor and stop skills, but miss one and you are wide open. Rocket or Guan into an enemy for an aerial grab.</li>
      <li><b>Movement techs:</b> Rocket (→→↑), Shadow Step (→→↑↓, repeat), Mushidon (→→↑↓ together), Guan Step (↑ dash ↓), Front Spell (dash + skill), Bleach (combo + skill), OttoShot (↓+Z on a platform). See the <a href="/chase/guide/">guide</a>.</li>
      <li><b>Counter:</b> getting comboed? Press <kbd>C</kbd> while you are hit to spend 1 bar and break free with invulnerability.</li>
      <li><b>Getting up</b> after a knockdown makes you invulnerable for a moment. Don't waste your combo on a fighter who is getting up!</li>
      <li><b>Ranked:</b> after {CALIBRATION} calibration fights you get a medal ({MEDALS.map((m) => m.name).join(', ')}) with 5 stars each. Every opponent's rating counts: beating a stronger player pays more, players on the same network don't move rating.</li>
    </ol>
    <h3>The fighters</h3>
    <ul>
      {heroes.map((h) => <li><b>{h}</b>: {CHAR_IDS.filter((id) => CHARS[id].hero === h).map((id) => `${CHARS[id].cls} (${TIERS[CHARS[id].tier]})`).join(', ')}.</li>)}
    </ul>
    <p>Modes: {Object.values(MODES).map((m) => m.name).join(', ')}. Arenas: {MAPS.map((m) => m.name).join(', ')}.</p>
    <p class="small muted">Fan-made game inspired by the classic side-scrolling PvP of Grand Chase and by Roblox. Original characters; not affiliated with KOG or Roblox. Names are generated, there is no chat.</p>
  </section>

  <style is:global>
    .bc { position: relative; height: min(86vh, 820px); min-height: 540px; border-radius: 20px; overflow: hidden; background: #07060c; box-shadow: var(--neu-lg); touch-action: none; user-select: none; -webkit-user-select: none; }
    #bc-canvas { width: 100%; height: 100%; display: block; }
    .bc-vignette { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(ellipse at center, transparent 55%, rgba(0, 0, 0, 0.55)); }
    .bc.menu .bc-vignette { background: radial-gradient(ellipse at 30% 60%, transparent 25%, rgba(5, 4, 12, 0.7) 80%); }
    .bc-hud { position: absolute; inset: 0; pointer-events: none; font-family: var(--fun); }
    .bc-cards { position: absolute; top: 10px; left: 10px; right: 10px; display: flex; gap: 8px; justify-content: space-between; flex-wrap: wrap; }
    .bc-cards > div { position: relative; display: grid; grid-template-columns: 40px 1fr; gap: 0 8px; align-items: center; width: min(250px, calc(33% - 8px)); padding: 6px 10px 7px; border-radius: 12px; background: linear-gradient(135deg, rgba(10, 10, 20, 0.85), rgba(25, 20, 40, 0.75)); border: 2px solid color-mix(in srgb, var(--t) 60%, transparent); box-shadow: 0 6px 18px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.08); transition: transform 0.2s, opacity 0.4s; }
    .bc-cards > div.me { border-color: #ffd23f; box-shadow: 0 0 18px rgba(255, 210, 63, 0.35); }
    .bc-cards > div.dead { opacity: 0.45; filter: grayscale(1); }
    .bc-cards > div.low .v { animation: bc-blink 0.5s steps(2) infinite; }
    .bc-cards .av { grid-row: span 4; width: 40px; height: 40px; border-radius: 10px; overflow: hidden; background: color-mix(in srgb, var(--c) 30%, #000); }
    .bc-cards .av svg { width: 40px; height: 40px; }
    .bc-cards b { color: #fff; font-size: 14px; line-height: 1.1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-shadow: 0 2px 0 #000; }
    .bc-cards small { color: var(--c); font-size: 11px; line-height: 1.2; filter: brightness(1.4); }
    .bc-cards .hp { position: relative; height: 10px; margin-top: 3px; border-radius: 5px; background: rgba(0, 0, 0, 0.6); overflow: hidden; box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12); }
    .bc-cards .hp u { position: absolute; left: 0; top: 0; bottom: 0; }
    .bc-cards .hp .g { background: #fff1b8; }
    .bc-cards .hp .v { background: linear-gradient(180deg, #8dff8a, #22c55e 55%, #15803d); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.5); transition: width 0.08s; }
    .bc-cards .low .hp .v { background: linear-gradient(180deg, #ff9a8a, #ef4444 55%, #991b1b); }
    .bc-cards .mp { display: grid; grid-template-columns: repeat(3, 1fr); gap: 3px; height: 6px; margin-top: 3px; }
    .bc-cards .mp u.c { box-shadow: 0 0 10px #8fe3ff, inset 0 0 0 1px #fff; }
    .bc-cards .mp u { --f: 0; border-radius: 3px; background: linear-gradient(90deg, #3cc8ff calc(var(--f) * 100%), rgba(0, 0, 0, 0.6) 0); box-shadow: inset 0 0 0 1px rgba(60, 200, 255, 0.25); }
    .bc-timer { position: absolute; top: 74px; left: 50%; translate: -50% 0; font: 400 34px 'Bangers', var(--fun); letter-spacing: 2px; color: #fff; text-shadow: 0 3px 0 #000, 0 0 16px rgba(255, 210, 63, 0.5); }
    .bc-timer.hurry { color: #ff5a5a; animation: bc-blink 0.6s steps(2) infinite; }
    .bc-combo { position: absolute; right: 18px; top: 38%; text-align: right; display: grid; opacity: 0; transform: translateX(30px); transition: opacity 0.3s, transform 0.3s; }
    .bc-combo.on { opacity: 1; transform: none; }
    .bc-combo b { font: 400 clamp(54px, 9vw, 86px)/0.9 'Bangers', var(--fun); color: #ffd23f; text-shadow: 0 4px 0 #a5400f, 0 0 24px rgba(255, 140, 0, 0.7); }
    .bc-combo span { font: 400 24px 'Bangers', var(--fun); letter-spacing: 3px; color: #fff; text-shadow: 0 2px 0 #000; }
    .bc-combo small { color: #ffe9a8; font-size: 13px; }
    .bc-combo.pop b { animation: bc-pop 0.25s cubic-bezier(0.3, 1.8, 0.5, 1); }
    @keyframes bc-pop { 0% { transform: scale(1.6) rotate(-6deg); } }
    .bc-skillbar { position: absolute; left: 50%; bottom: 12px; translate: -50% 0; display: flex; gap: 6px; flex-wrap: wrap; justify-content: center; font-size: 12px; color: #cfd3e6; width: max-content; max-width: calc(100% - 20px); }
    .bc-skillbar span { display: flex; gap: 5px; align-items: center; padding: 4px 9px 4px 4px; border-radius: 9px; background: rgba(8, 8, 16, 0.75); border: 1px solid rgba(255, 255, 255, 0.08); }
    .bc-skillbar [data-sk] { opacity: 0.45; transition: opacity 0.2s, box-shadow 0.2s; }
    .bc-skillbar [data-sk].ready { opacity: 1; border-color: #3cc8ff; box-shadow: 0 0 12px rgba(60, 200, 255, 0.45); }
    .bc kbd, .bc-keys kbd, .prose kbd { display: inline-grid; place-items: center; min-width: 22px; height: 22px; padding: 0 5px; border-radius: 6px; background: #f2f2f6; color: #111; font: 700 12px var(--fun); box-shadow: 0 2px 0 #8a8fa3; }
    .bc-nums { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
    .bc-num { position: absolute; translate: -50% -50%; font: 400 30px 'Bangers', var(--fun); letter-spacing: 1px; color: #fff; text-shadow: 0 3px 0 #000, 0 0 10px rgba(0, 0, 0, 0.6); animation: bc-num 0.9s cubic-bezier(0.2, 0.9, 0.3, 1) forwards; }
    .bc-num.mine { color: #ffd23f; font-size: 36px; }
    .bc-num.hurt { color: #ff5a5a; }
    .bc-num.skill { font-size: 26px; color: var(--c); filter: brightness(1.5); animation-duration: 1.1s; white-space: nowrap; }
    @keyframes bc-num { 0% { opacity: 0; transform: translateY(10px) scale(1.8); } 15% { opacity: 1; transform: scale(1); } 100% { opacity: 0; transform: translateY(-60px) scale(0.9); } }
    .bc-cut { position: absolute; inset: 0; pointer-events: none; opacity: 0; display: grid; place-items: center; }
    .bc-cut i { position: absolute; left: 0; right: 0; height: 13%; background: #000; transform: scaleY(0); }
    .bc-cut i:first-child { top: 0; transform-origin: top; } .bc-cut i:nth-child(2) { bottom: 0; transform-origin: bottom; }
    .bc-cut b { position: absolute; left: 6%; bottom: 16%; font: 400 clamp(36px, 7vw, 74px)/1 'Bangers', var(--fun); letter-spacing: 3px; color: #fff; text-shadow: 0 0 30px var(--c), 0 4px 0 #000; transform: translateX(-120%) skewX(-12deg); }
    .bc-cut small { position: absolute; left: 6.4%; bottom: calc(16% - 22px); color: #ddd; font: 600 14px var(--fun); letter-spacing: 2px; text-transform: uppercase; opacity: 0; }
    .bc-cut.go { opacity: 1; animation: bc-cutfade 0.9s ease forwards; } /* visible even with reduced motion (animations off) */
    .bc-cut.go i { transform: scaleY(1); } .bc-cut.go b { transform: skewX(-12deg); } .bc-cut.go small { opacity: 1; }
    .bc-cut.go i { animation: bc-bars 0.9s ease forwards; }
    .bc-cut.go b { animation: bc-name 0.9s cubic-bezier(0.2, 0.9, 0.3, 1) forwards; }
    .bc-cut.go small { animation: bc-cutfade 0.9s ease 0.1s forwards; }
    @keyframes bc-cutfade { 0%, 100% { opacity: 0; } 8%, 80% { opacity: 1; } }
    @keyframes bc-bars { 0% { transform: scaleY(0); } 12%, 80% { transform: scaleY(1); } 100% { transform: scaleY(0); } }
    @keyframes bc-name { 0% { transform: translateX(-120%) skewX(-12deg); } 18% { transform: translateX(0) skewX(-12deg); } 75% { transform: translateX(4%) skewX(-12deg); opacity: 1; } 100% { transform: translateX(30%) skewX(-12deg); opacity: 0; } }
    .bc-banner { position: absolute; top: 40%; left: 50%; translate: -50% -50%; text-align: center; opacity: 0; pointer-events: none; display: grid; width: 92%; }
    .bc-banner b { font: 400 clamp(64px, 14vw, 150px)/0.9 'Bangers', var(--fun); letter-spacing: 4px; color: #fff; text-shadow: 0 6px 0 #6d28d9, 0 0 40px rgba(184, 108, 245, 0.8); }
    .bc-banner.fight b { color: #ffd23f; text-shadow: 0 6px 0 #b45309, 0 0 50px rgba(255, 170, 0, 0.9); }
    .bc-banner.ko b { color: #ff3b3b; text-shadow: 0 6px 0 #450a0a, 0 0 50px rgba(255, 0, 0, 0.8); }
    .bc-banner span { font: 600 clamp(16px, 3vw, 22px) var(--fun); color: #fff; text-shadow: 0 2px 0 #000; }
    .bc-banner.go { opacity: 1; animation: bc-banner 1.2s cubic-bezier(0.2, 0.9, 0.3, 1.2) both; }
    @keyframes bc-banner { 0% { opacity: 0; transform: scale(2.4); filter: blur(10px); } 18% { opacity: 1; transform: scale(1); filter: none; } 80% { opacity: 1; } 100% { opacity: 0; transform: scale(0.9); } }
    @keyframes bc-blink { 50% { opacity: 0.45; } }
    .bc-tools { position: absolute; right: 10px; bottom: 10px; display: flex; gap: 6px; z-index: 6; }
    .bc-tools .btn { padding: 7px 10px; font-size: 14px; }
    .bc.menu #bc-leave { display: none; }
    .bc:not(.menu) .bc-tools { bottom: auto; top: 76px; }
    .bc-touch { display: none; }
    @media (pointer: coarse) {
      .bc-touch { display: block; }
      .bc-skillbar { display: none; }
      .bc-touch button { pointer-events: auto; border: 0; border-radius: 50%; background: rgba(15, 15, 30, 0.55); color: #fff; font: 600 13px var(--fun); box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.18); touch-action: none; }
      .bc-touch button.on { background: rgba(255, 210, 63, 0.55); }
      .bc-touch .pad { position: absolute; left: 14px; bottom: 14px; display: grid; grid-template: 'u u' 'l r' 'd d' / 58px 58px; gap: 4px; }
      .bc-touch .pad button { width: 58px; height: 52px; border-radius: 14px; font-size: 18px; }
      .bc-touch .pad [data-k='U'] { grid-area: u; justify-self: center; } .bc-touch .pad [data-k='L'] { grid-area: l; } .bc-touch .pad [data-k='R'] { grid-area: r; } .bc-touch .pad [data-k='D'] { grid-area: d; justify-self: center; }
      .bc-touch .acts { position: absolute; right: 12px; bottom: 12px; display: grid; grid-template-columns: repeat(4, 54px); gap: 6px; direction: rtl; }
      .bc-touch .acts button { width: 54px; height: 54px; }
      .bc-touch .acts .big { width: 54px; height: 54px; background: rgba(255, 60, 90, 0.55); font-size: 20px; }
      .bc-touch .acts .sk { background: rgba(60, 140, 255, 0.5); }
    }
    @media (pointer: coarse) and (max-width: 520px) {
      .bc-touch .pad { left: 8px; bottom: 10px; grid-template-columns: 48px 48px; }
      .bc-touch .pad button { width: 48px; height: 44px; }
      .bc-touch .acts { right: 8px; bottom: 10px; grid-template-columns: repeat(4, 46px); gap: 5px; }
      .bc-touch .acts button, .bc-touch .acts .big { width: 46px; height: 46px; font-size: 12px; }
    }
    .bc-panel { position: absolute; inset: 0; display: grid; place-items: center; z-index: 5; padding: 12px; }
    #bc-menu { place-items: center end; padding-right: 4%; }
    .bc-card { width: min(560px, 100%); max-height: 100%; overflow: auto; padding: 22px; border-radius: 20px; background: linear-gradient(160deg, rgba(20, 16, 34, 0.92), rgba(10, 9, 18, 0.92)); border: 1px solid rgba(255, 210, 63, 0.18); backdrop-filter: blur(10px); box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.06); animation: bc-in 0.45s cubic-bezier(0.2, 0.9, 0.3, 1.1); text-align: center; }
    @keyframes bc-in { from { opacity: 0; transform: translateX(40px) skewX(-6deg); filter: blur(6px); } }
    .bc-title-card { width: min(470px, 100%); }
    .bc-logo { margin: 0; font: 400 clamp(56px, 10vw, 84px)/0.9 'Bangers', var(--fun); letter-spacing: 3px; color: #fff; text-shadow: 0 5px 0 #6d28d9, 0 0 40px rgba(184, 108, 245, 0.55); transform: skewX(-6deg); }
    .bc-logo span { color: #ffd23f; text-shadow: 0 5px 0 #b45309, 0 0 40px rgba(255, 170, 0, 0.55); margin-left: 10px; }
    .bc-sub { color: var(--muted); margin: 4px 0 12px; font-size: 14px; }
